class LaneContext:
    """Mutable detection state for exactly one lane."""

    def __init__(self, lane, mass_config):
        self.lane = str(lane)
        self.mass_config = massSensor.normalizeConfig(mass_config)
        self.clear_debounce_ms = self.mass_config["clearDebounceMs"]
        self.massQ = queue.Queue(maxsize=5000)
        self.lastPublishedMassState = None
        self.responseQ = queue.Queue(maxsize=1000)
        self.reports = []
        self.squelch = []
        self.lock = threading.RLock()
        self.arbitrationWindowActivity = None
        self.requireValidatedFastFlow = any(
            bool(getattr(driverModule, "requireValidatedFastFlow", False))
            for driverModule in readDrivers.values()
        )
        self.retrySlowWhileOccupied = all(
            bool(getattr(driverModule, "retrySlowWhileOccupied", True))
            for driverModule in readDrivers.values()
        )
        self.requireTrackedSlowPassage = any(
            bool(getattr(driverModule, "requireTrackedSlowPassage", False))
            for driverModule in readDrivers.values()
        )
        self.lastFastGood = False
        self.lastFastTid = None
        self.lastFastValid = False


def recordFastAcceptance(context, read):
    if not context.requireValidatedFastFlow:
        return
    context.lastFastGood = True
    context.lastFastTid = read.get("tid")
    context.lastFastValid = False


def recordFastValidation(context, response):
    if not context.requireValidatedFastFlow or not context.lastFastGood:
        return
    if response.get("tid") == context.lastFastTid and response.get("valid"):
        context.lastFastValid = True


def resetFastValidation(context):
    context.lastFastGood = False
    context.lastFastTid = None
    context.lastFastValid = False


def fastTriggerAllowed(context, mid, slow):
    if not context.requireValidatedFastFlow:
        return True
    previousFastValid = context.lastFastGood and context.lastFastValid
    # Every real fast edge supersedes the preceding one. Consume its state even
    # when this trigger is blocked so a late response cannot authorize a third car.
    resetFastValidation(context)
    return previousFastValid or (mid == 0 and slow == 0)


class ReaderCommandError(RuntimeError):
    pass


class DelimitedReaderConnection:
    """Buffered TCP connection for the reader's CRLF-delimited protocol."""

    def __init__(self, host, port, timeout=5, socket_factory=socket.create_connection):
        self.host = host
        self.port = int(port)
        self.socket = socket_factory((host, self.port), timeout)
        self.socket.settimeout(1.0)
        self.buffer = b""

    def readFrame(self, stop_event=None, timeout=None):
        deadline = None
        if timeout is not None:
            deadline = time.monotonic() + max(0, float(timeout))

        while True:
            marker = self.buffer.find(READER_FRAME_DELIMITER)
            if marker >= 0:
                frame = self.buffer[:marker]
                self.buffer = self.buffer[marker + len(READER_FRAME_DELIMITER):]
                return frame.decode("ascii", errors="replace").strip()

            if len(self.buffer) > READER_MAX_FRAME_BYTES:
                raise ConnectionError(
                    f"reader frame exceeded {READER_MAX_FRAME_BYTES} bytes without delimiter"
                )

            if stop_event is not None and stop_event.is_set():
                return None
            if deadline is not None and time.monotonic() >= deadline:
                raise TimeoutError(
                    f"timed out waiting for reader frame from {self.host}:{self.port}"
                )

            try:
                chunk = self.socket.recv(4096)
            except socket.timeout:
                continue
            if not chunk:
                raise ConnectionError("reader event connection closed")
            self.buffer += chunk

    def close(self):
        try:
            self.socket.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        self.socket.close()


class ReaderLinkHealth:
    """Thread-safe state used by the parent to supervise the shared RF link."""

    def __init__(self):
        self.lock = threading.Lock()
        self.connected = False
        self.disconnectedSince = time.monotonic()
        self.lastEventAt = None
        self.lastError = "not connected"

    def markConnected(self):
        with self.lock:
            self.connected = True
            self.disconnectedSince = None
            self.lastError = ""

    def markEvent(self):
        with self.lock:
            self.lastEventAt = time.monotonic()

    def markDisconnected(self, error):
        with self.lock:
            if self.connected or self.disconnectedSince is None:
                self.disconnectedSince = time.monotonic()
            self.connected = False
            self.lastError = str(error)

    def disconnectedFor(self):
        with self.lock:
            if self.connected or self.disconnectedSince is None:
                return 0.0
            return time.monotonic() - self.disconnectedSince

    def error(self):
        with self.lock:
            return self.lastError


class CrossLaneArbiter:
    """Assign qualified lane/side/TID pools as one passage-level matching.

    Each lane/side slot submits every qualified candidate in its current mass
    window. An uncontested active lane claims immediately; simultaneous active
    lanes wait briefly for a matching with at most one TID per slot and at most
    one slot per TID. Once assigned, later fast/slow reads for the winning lane
    remain valid and renew ownership while other lanes are suppressed.
    """

    def __init__(
        self,
        arbitration_ms=150,
        assignment_ms=5000,
        mass_tolerance_ms=10,
    ):
        self.arbitration_seconds = max(0, int(arbitration_ms)) / 1000.0
        self.assignment_seconds = max(1, int(assignment_ms)) / 1000.0
        self.mass_tolerance_ms = max(0, float(mass_tolerance_ms))
        self.condition = threading.Condition()
        self.pendingBatch = None
        self.activeWindows = {}
        self.assignments = {}
        self.lastAmbiguityLogAt = 0.0

    def setLaneWindowActivity(self, lane, fastActive, slowActive):
        """Publish the lane's current mass-gated RF window activity."""
        lane = str(lane)
        updates = {
            (lane, ANTENNA_FAST): bool(fastActive),
            (lane, ANTENNA_SLOW): bool(slowActive),
        }
        with self.condition:
            changed = any(
                self.activeWindows.get(slot) != active
                for slot, active in updates.items()
            )
            self.activeWindows.update(updates)
            if changed:
                self.condition.notify_all()

    def _active_lanes(self):
        return {
            slot[0]
            for slot, active in self.activeWindows.items()
            if active
        }

    def _clean_assignments(self, now):
        expired = [tid for tid, value in self.assignments.items() if value[1] <= now]
        for tid in expired:
            del self.assignments[tid]

    @staticmethod
    def _candidate_sort_key(item):
        lane, evidence = item
        return (
            -int(bool(evidence.get("massActive", False))),
            float(evidence.get("massOffsetMs", 999999999)),
            -int(evidence.get("reads", 0)),
            -int(evidence.get("rssi", -999999)),
            str(lane),
        )

    def _cross_lane_evidence_ambiguous(self, first, second):
        if bool(first.get("massActive", False)) != bool(
            second.get("massActive", False)
        ):
            return False
        firstOffset = float(first.get("massOffsetMs", 999999999))
        secondOffset = float(second.get("massOffsetMs", 999999999))
        if firstOffset == secondOffset:
            return True
        difference = abs(firstOffset - secondOffset)
        if difference != difference:  # NaN, including inf - inf
            return True
        return difference <= self.mass_tolerance_ms

    def _best_matching(self, pools):
        """Return conservative mutual-best slot/TID assignments.

        A slot must prefer the TID, and the TID must independently prefer that
        lane. Weak fallback candidates are never used merely to fill more
        slots. Cross-lane mass timing inside the configured tolerance fails
        closed because RF count/RSSI can be dominated by antenna bleed.
        """
        slotWinners = {}
        candidatesByTid = {}

        for slot, pool in pools.items():
            if not pool:
                continue
            selectedTid, selectedEvidence = min(
                pool.items(),
                key=lambda item: self._candidate_sort_key(item),
            )
            slotWinners[slot] = (selectedTid, selectedEvidence)
            for tid, evidence in pool.items():
                candidatesByTid.setdefault(tid, []).append((slot, evidence))

        winningLaneByTid = {}
        for tid, candidates in candidatesByTid.items():
            bestByLane = {}
            for slot, evidence in candidates:
                lane = slot[0]
                current = bestByLane.get(lane)
                if current is None or (
                    self._candidate_sort_key((slot, evidence))
                    < self._candidate_sort_key(current)
                ):
                    bestByLane[lane] = (slot, evidence)

            rankedLanes = sorted(
                bestByLane.items(),
                key=lambda item: (
                    self._candidate_sort_key((item[0], item[1][1])),
                    str(item[0]),
                ),
            )
            if len(rankedLanes) == 1:
                winningLaneByTid[tid] = rankedLanes[0][0]
                continue
            if not self._cross_lane_evidence_ambiguous(
                rankedLanes[0][1][1],
                rankedLanes[1][1][1],
            ):
                winningLaneByTid[tid] = rankedLanes[0][0]

        mutualByTid = {}
        for slot, selected in slotWinners.items():
            tid, evidence = selected
            if winningLaneByTid.get(tid) != slot[0]:
                continue
            mutualByTid.setdefault(tid, []).append((slot, evidence))

        matching = {}
        for tid, mutualCandidates in mutualByTid.items():
            selectedSlot, selectedEvidence = min(
                mutualCandidates,
                key=lambda item: (
                    self._candidate_sort_key(item),
                    str(item[0]),
                ),
            )
            matching[selectedSlot] = (tid, selectedEvidence)
        return matching

    def submitPool(self, lane, side, candidates, evidenceByTid=None):
        lane = str(lane)
        side = str(side or "")
        slot = (lane, side)
        evidenceByTid = evidenceByTid or {}

        with self.condition:
            now = time.monotonic()
            self._clean_assignments(now)

            pool = {}
            assignedHere = []
            for read in candidates:
                tid = str(read.get("tid", ""))
                if not tid:
                    continue
                assigned = self.assignments.get(tid)
                if assigned is not None and assigned[0] != lane:
                    continue
                evidence = dict(evidenceByTid.get(tid, {}))
                evidence.setdefault("reads", read.get("reads", read.get("count", 0)))
                evidence.setdefault("rssi", read.get("rssi", -999999))
                pool[tid] = evidence
                if assigned is not None:
                    assignedHere.append(tid)

            # Preserve an existing TID-to-lane decision across fast/slow reads.
            if assignedHere:
                assignedTid = sorted(
                    assignedHere,
                    key=lambda tid: self._candidate_sort_key((lane, pool[tid])),
                )[0]
                # A later fast/slow sighting in the owning lane is part of the
                # same passage, so keep the lane claim alive from this sighting.
                self.assignments[assignedTid] = (
                    lane,
                    now + self.assignment_seconds,
                )
                return next(
                    (read for read in candidates if str(read.get("tid", "")) == assignedTid),
                    None,
                )
            if not pool:
                return None

            # Most passages occupy only one lane. In that case there is no
            # competing mass-gated lane evidence to wait for: claim the best
            # qualified TID immediately. A live pending batch always wins this
            # check so an in-flight contender cannot be bypassed.
            if self.pendingBatch is None and self._active_lanes() == {lane}:
                matching = self._best_matching({slot: pool})
                selected = matching.get(slot)
                if selected is None:
                    return None
                selectedTid = selected[0]
                assigned = self.assignments.get(selectedTid)
                if assigned is not None and assigned[0] != lane:
                    return None
                self.assignments[selectedTid] = (
                    lane,
                    now + self.assignment_seconds,
                )
                return next(
                    (read for read in candidates if str(read.get("tid", "")) == selectedTid),
                    None,
                )

            batch = self.pendingBatch
            if batch is None:
                batch = {
                    "deadline": now + self.arbitration_seconds,
                    "pools": {},
                    "reads": {},
                    "decisions": None,
                }
                self.pendingBatch = batch

            batch["pools"][slot] = pool
            batch["reads"][slot] = {
                str(read.get("tid", "")): read for read in candidates if read.get("tid")
            }

            while batch["decisions"] is None:
                remaining = batch["deadline"] - time.monotonic()
                if remaining > 0:
                    self.condition.wait(timeout=remaining)
                    continue

                resolutionNow = time.monotonic()
                self._clean_assignments(resolutionNow)
                eligiblePools = {}
                for poolSlot, submittedPool in batch["pools"].items():
                    poolLane = poolSlot[0]
                    eligiblePool = {
                        tid: evidence
                        for tid, evidence in submittedPool.items()
                        if tid not in self.assignments
                        or self.assignments[tid][0] == poolLane
                    }
                    if eligiblePool:
                        eligiblePools[poolSlot] = eligiblePool

                matching = self._best_matching(eligiblePools)
                if not matching and len(eligiblePools) > 1:
                    nowMonotonic = time.monotonic()
                    if nowMonotonic - self.lastAmbiguityLogAt >= 60:
                        summary = {
                            f"{poolSlot[0]}/{poolSlot[1] or 'unspecified'}": sorted(pool)
                            for poolSlot, pool in eligiblePools.items()
                        }
                        message = (
                            f"CROSS LANE AMBIGUOUS pools:{summary}; "
                            "no tag assignment emitted"
                        )
                        if LOG_EVENTS:
                            print(message)
                            akiraCore.log(message)
                        self.lastAmbiguityLogAt = nowMonotonic
                batch["decisions"] = {}
                assignmentExpiry = time.monotonic() + self.assignment_seconds
                for selectedSlot, selected in matching.items():
                    selectedLane = selectedSlot[0]
                    selectedTid = selected[0]
                    assigned = self.assignments.get(selectedTid)
                    if assigned is not None and assigned[0] != selectedLane:
                        continue
                    self.assignments[selectedTid] = (selectedLane, assignmentExpiry)
                    batch["decisions"][selectedSlot] = selectedTid
                if self.pendingBatch is batch:
                    self.pendingBatch = None
                self.condition.notify_all()

            selectedTid = batch["decisions"].get(slot)
            if selectedTid is None:
                return None
            return batch["reads"][slot].get(selectedTid)

    def submit(self, read, evidence=None):
        lane = str(read.get("lane", ""))
        tid = str(read.get("tid", ""))
        if not lane or not tid:
            return False
        winner = self.submitPool(
            lane,
            read.get("side", ""),
            [read],
            {tid: dict(evidence or {})},
        )
        return winner is not None and str(winner.get("tid", "")) == tid

    def assignedLane(self, tid):
        with self.condition:
            now = time.monotonic()
            self._clean_assignments(now)
            assigned = self.assignments.get(str(tid))
            return assigned[0] if assigned is not None else None


