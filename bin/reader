#######################
def rfThread(stop_event, initialConnection, linkHealth):

    connection = initialConnection
    lastError = None
    lastErrorLogAt = 0.0

    while not stop_event.is_set():
        try:
            if connection is None:
                connection = reconnectReaderEvent(stop_event)
                setActiveEventConnection(connection)
                if stop_event.is_set():
                    closeActiveEventConnection()
                    return
                akiraCore.log(f"reader {readerName} RF event connection restored")
            linkHealth.markConnected()

            event = connection.readFrame(stop_event=stop_event)
            if event is None:
                return
            if DEBUG_READER_RECV:
                print(readerIp + " << " + event)
            linkHealth.markEvent()
            try:
                rfQ.put(event, timeout=0.05)
            except queue.Full:
                msg = "reader rfQ full - RF dispatch is not draining"
                print(msg)
                akiraCore.log(msg)
        except Exception as ex:
            if stop_event.is_set():
                return
            linkHealth.markDisconnected(ex)
            nowMonotonic = time.monotonic()
            errorText = str(ex)
            if errorText != lastError or nowMonotonic - lastErrorLogAt >= 60:
                msg = f"reader {readerName} RF link lost: {errorText}; reconnecting"
                print(msg)
                akiraCore.log(msg)
                lastError = errorText
                lastErrorLogAt = nowMonotonic
            try:
                connection.close()
            except Exception:
                pass
            connection = None
            setActiveEventConnection(None)
            stop_event.wait(READER_RECONNECT_SECONDS)

#######################
def rfDispatchThread(stop_event):
    while not stop_event.is_set():
        try:
            event = rfQ.get(timeout=0.25)
        except queue.Empty:
            continue
        try:
            if event is STOP:
                return
            parseEvent(event)
        except Exception as ex:
            print(f"rfDispatchThread(): {ex}")
            traceback.print_exc()
            akiraCore.log(f"rfDispatchThread(): {ex}")
        finally:
            rfQ.task_done()


#######################
def driverResponseThread(stop_event):
    while not stop_event.is_set():
        responses = []
        for driverName, driverModule in readDrivers.items():
            try:
                if hasattr(driverModule, "getResponses"):
                    responses.extend(driverModule.getResponses())
            except Exception as ex:
                akiraCore.log(f"reader.driverResponseThread {driverName}: {ex}")

        for response in responses:
            if DEBUG_DRIVER_RESPONSES:
                print(response)
            if response.get('type') != "tagResult":
                continue

            if LOG_EVENTS:
                out = (
                    f">>> lane:{response.get('lane')} {response.get('tid')} "
                    f"code:{response.get('code')} {response.get('valid')}"
                )
                akiraCore.appendFile(LOG_EVENTS_FILE, out + '\n')

            response['op'] = "addResp"
            akiraCore.queueXmit(
                json.dumps(response, default=akiraCore.jsonConverter),
                akiraCore.QUEUE_EXTENSION_RESPONSE,
            )

            context = getLaneContext(response.get('lane', ''))
            if context is None:
                akiraCore.log(
                    f"reader.driverResponseThread response for unknown lane {response.get('lane')}"
                )
                continue
            try:
                context.responseQ.put(response, timeout=0.05)
            except queue.Full:
                akiraCore.log(f"reader responseQ full for lane {context.lane}")

        if not responses:
            stop_event.wait(0.02)


#######################
def massThread(context, stop_event):
    mass = context.mass_config
    massIp = mass['ip']
    print("MASS THREAD START " + context.lane)
    lastError = None
    lastErrorLogAt = 0.0

    while not stop_event.is_set():
        tnConn = None
        try:
            if DEBUG_MASS:
                print(f"Connecting lane {context.lane} to Numato GPIO @ {massIp}:{MASS_PORT}")
            tnConn = NumatoConnection(massIp, MASS_PORT, timeout=5)
            login(tnConn)
            if lastError is not None:
                akiraCore.log(f"massThread({context.lane}): reconnected to {massIp}")
                lastError = None
            setAllInputsAndNotify(tnConn, context)
            monitorNotifications(tnConn, stop_event, context)
        except Exception as ex:
            if not stop_event.is_set():
                errorText = str(ex)
                nowMonotonic = time.monotonic()
                if errorText != lastError or nowMonotonic - lastErrorLogAt >= 300:
                    msg = f"massThread({context.lane}): {errorText}; reconnecting"
                    print(msg)
                    akiraCore.log(msg)
                    lastErrorLogAt = nowMonotonic
                lastError = errorText
        finally:
            if tnConn is not None:
                try:
                    tnConn.close()
                except Exception:
                    pass

        if stop_event.wait(massReconnectSeconds):
            break


#######################
def notifyLaneClear(lane):
    for driverName, driverModule in readDrivers.items():
        if DEBUG_DRIVER:
            print("running driver: " + str(driverName))
        if hasattr(driverModule, "laneClear"):
            driverModule.laneClear(lane)


#######################
def massClearReady(lastMass, clearDebounceMs, now=None):
    now = now or datetime.now()
    if not all(int(lastMass.get(key, -1)) == 0 for key in ("trip", "main", "rear")):
        return False
    clearSince = lastMass.get("clearSince")
    if clearSince is None:
        return False
    return now >= clearSince + timedelta(milliseconds=clearDebounceMs)


def syncArbitrationWindowActivity(context, fastWindow, slowWindow):
    """Publish non-expired mass-window activity for hybrid arbitration."""
    now = datetime.now()
    activity = (
        fastWindow.get("reading", False) and now <= fastWindow.get("end", now),
        slowWindow.get("reading", False) and now <= slowWindow.get("end", now),
    )
    if context.arbitrationWindowActivity == activity:
        return
    context.arbitrationWindowActivity = activity
    tagArbiter.setLaneWindowActivity(
        context.lane,
        activity[0],
        activity[1],
    )


#######################
def laneThread(context, stop_event):

    lane = context.lane
    print("LANE THREAD START " + lane + '\n')

    massTrip = -1
    massMain = -1
    massRear = -1
    massDate = datetime.now()

    #lastMassTrip = -1
    #lastMassMain = -1
    #lastMassRear = -1
    #lastMassDate = datetime.now()

    lastMass = {
        "trip": -1,
        "tripLast": datetime.now(),
        "main": -1,
        "mainLast": datetime.now(),
        "rear": -1,
        "rearLast": datetime.now(),
        "clearSince": None,
        "lastUnlocked": datetime.now(),
        "updated": datetime.now(),
        "unlockLockout": False,
    }

    passages = LanePassages()
    lastFastClearAt = None

    lastFc = -1
    lastSc = -1
    lastSquelchCount = -1

    fastWindow = resetWindow("fast - initial") #{'locked':False,'reading':False,'begin':datetime.now(),'end':datetime.now(),'updated':datetime.now()}
    slowWindow = resetWindow("slow - initial") #{'locked':False,'reading':False,'begin':datetime.now(),'end':datetime.now(),'updated':datetime.now()}
    #print(fastWindow)
    #print(slowWindow)

    massUpdated = False

    while not stop_event.is_set():

        try:
            updates = False
            massUpdated = False

            # Process mass changes in order. Draining the queue and applying
            # only its final item can lose a short occupied transition.
            try:
                massEvent = context.massQ.get_nowait()
                if massEvent is STOP:
                    context.massQ.task_done()
                    return
                massUpdated = True
                updates = True
                context.massQ.task_done()
            except queue.Empty:
                pass

            # if no updates yield CPU
            if not updates:
                time.sleep(0.002)

            responses = []
            while True:
                try:
                    response = context.responseQ.get_nowait()
                except queue.Empty:
                    break
                if response is STOP:
                    context.responseQ.task_done()
                    return
                responses.append(response)
                context.responseQ.task_done()

            for response in responses:
                if response.get('type') == "tagResult":
                    recordFastValidation(context, response)
                    passages.response(response, datetime.now() + timedelta(seconds=1))

            # if mass has changed state - set windows
            if massUpdated:
                massTrip = int(massEvent.get("fast", massEvent.get("trip", -1)))
                massMain = int(massEvent.get("mid", massEvent.get("main", -1)))
                massRear = int(massEvent.get("slow", massEvent.get("rear", -1)))
                massDate = massEvent.get("date", datetime.now())
                logicalChanged = any(
                    lastMass[key] != value
                    for key, value in (
                        ("trip", massTrip),
                        ("main", massMain),
                        ("rear", massRear),
                    )
                )

                #################
                #all sensors clear
                if massMain == 0 and massTrip == 0 and massRear == 0:
                    wasClear = all(lastMass[key] == 0 for key in ("trip", "main", "rear"))
                    if not wasClear or lastMass["clearSince"] is None:
                        lastMass["clearSince"] = massDate
                    if wasClear and not lastMass["unlockLockout"]:
                        pass
                    elif massClearReady(lastMass, context.clear_debounce_ms):
                        fastWindow = resetWindow(f"fast - lane clear {massTrip}{massMain}{massRear}")
                        slowWindow = resetWindow(f"slow - lane clear {massTrip}{massMain}{massRear}")
                        lastMass["lastUnlocked"] = datetime.now()
                        lastMass["unlockLockout"] = False
                        resetFastValidation(context)
                        notifyLaneClear(lane)
                        passages.clear()
                    else:
                        lastMass['unlockLockout'] = True
                        print(f"lane:{lane} unlock lockout {massTrip} {massMain} {massRear}")
                else:
                    lastMass["clearSince"] = None
                    lastMass["unlockLockout"] = False

                # Handle the downstream edge first if both ends change in
                # one snapshot; a car already at the gate precedes a new arrival.
                if lastMass['main'] == -1:
                    passages.initialize_occupied(massMain, massRear)
                #################
                #if theres a change in rear
                if massRear == 1 and lastMass['rear'] != 1:
                    trackedSlowPassage = passages.slow is not None or bool(passages.waiting)
                    passage = passages.slow_trigger()
                    for driverModule in readDrivers.values():
                        if hasattr(driverModule, "passageState"):
                            driverModule.passageState(lane, passage.id, True)
                    if context.requireTrackedSlowPassage and not trackedSlowPassage:
                        slowWindow = resetWindow(
                            f"slow - no tracked passage {massTrip}{massMain}{massRear}"
                        )
                        print(
                            f"lane:{lane} NOT READING SLOW {massTrip}{massMain}{massRear} "
                            "- no tracked passage"
                        )
                    else:
                        begin = massDate + timedelta(milliseconds=slowPre)
                        end   = massDate + timedelta(milliseconds=slowPost)
                        #fastWindow = lockWindow("fast - main sensor") # <--- JM do we want this?
                        slowWindow = readWindow(slowWindow, begin, end, f"slow - rear sensor {massTrip}{massMain}{massRear}")
                elif massRear == 0 and lastMass['rear'] == 1:
                    passage = passages.slow
                    passages.pause_slow(massDate + timedelta(milliseconds=context.mass_config['slowClearDebounceMs']))
                    slowWindow = resetWindow("slow - vehicle left gate sensor")
                    if passage is not None:
                        for driverModule in readDrivers.values():
                            if hasattr(driverModule, "passageState"):
                                driverModule.passageState(lane, passage.id, False)


                #################
                #if theres a change in trip
                if massTrip == 0 and lastMass['trip'] == 1:
                    lastFastClearAt = massDate
                fastBounce = (passages.fast is not None and not passages.fast.ended
                              and lastFastClearAt is not None
                              and massDate < lastFastClearAt + timedelta(milliseconds=context.mass_config['fastClearDebounceMs']))
                if massTrip == 1 and lastMass['trip'] != 1 and not fastBounce:
                    passages.fast_trigger(massMain, massRear)
                    for retired in passages.retired:
                        for driverModule in readDrivers.values():
                            if hasattr(driverModule, "passageEnd"):
                                driverModule.passageEnd(lane, retired)
                    passages.retired.clear()
                    if fastTriggerAllowed(context, massMain, massRear):
                        begin = massDate + timedelta(milliseconds=fastPre)
                        end = massDate + timedelta(milliseconds=fastPost)
                        fastWindow = readWindow(fastWindow, begin, end, f"fast - trip sensor {massTrip}{massMain}{massRear}")
                    else:
                        fastWindow = resetWindow(
                            f"fast - lane occupied without validated flow {massTrip}{massMain}{massRear}"
                        )
                        print(
                            f"lane:{lane} NOT READING FAST {massTrip}{massMain}{massRear} "
                            "- lane occupied without a valid previous fast read"
                        )


                # Save change timestamps before replacing the previous state.
                if lastMass['trip'] != massTrip:
                    lastMass['tripLast'] = massDate
                if lastMass['main'] != massMain:
                    lastMass['mainLast'] = massDate
                if lastMass['rear'] != massRear:
                    lastMass['rearLast'] = massDate

                # save current state as last state
                lastMass["trip"] = massTrip
                lastMass["main"] = massMain
                lastMass["rear"] = massRear
                if logicalChanged:
                    lastMass["updated"] = massDate


                if DEBUG_MASS:
                    debugMass(context, massTrip, massMain, massRear, fastWindow, slowWindow, lastMass)

            if context.massQ.empty() and passages.release_due(datetime.now()):
                ended = passages.slow_clear()
                for driverModule in readDrivers.values():
                    if hasattr(driverModule, "passageEnd"):
                        driverModule.passageEnd(lane, ended.id)

            syncArbitrationWindowActivity(context, fastWindow, slowWindow)

            #################
            #check fast zone
            candidates = checkReadCandidates(
                context, fastWindow, ANTENNA_FAST, fastMinReads
            )
            read = arbitrateCandidates(candidates, lastMass)
            suppressCrossLaneAssignments(context, candidates)
            if read is not None:
                fastWindow = resetWindow(f"fast - read accepted {massTrip}{massMain}{massRear}")
                acceptCandidate(context, read)
                read.update(passages.fast.read_metadata())
                passages.fast.pending_id = read['id']
                recordFastAcceptance(context, read)
                sendRead(read)

                #flushReports(ANTENNA_FAST)
                if LOG_STATS:
                    akiraCore.appendFile(LOG_STATS_FILE,f"lane:{lane} fast: {read['tid']} reads:{read['reads']} {datetime.now().time()}\n")

                #make a fake tag response - only for debugging
                if GEN_FAKE_TAG_RESPONSE:
                    for driverName, driverModule in readDrivers.items():
                        if DEBUG_DRIVER:
                            print("running driver: " + str(driverName))
                        if hasattr(driverModule, "genFakeTagResponse"):
                            responses = driverModule.genFakeTagResponse(read['tid'])

            # A fast acceptance may have closed its window. Publish that before
            # deciding whether the slow pool has another active lane to contend.
            syncArbitrationWindowActivity(context, fastWindow, slowWindow)

            #################
            #check slow zone
            slowPassage = passages.slow
            if slowPassage is not None and slowPassage.authorized and slowPassage.authorized_tid:
                # A fast-authorized car still needs slow-side squelching. Its
                # lingering tag must not become a fallback for the next car.
                addSquelch(context, slowPassage.authorized_tid, ANTENNA_SLOW,
                           SQUELCH_TIME, refresh=True)
            if slowPassage is not None and (slowPassage.authorized or slowPassage.uncertain) and slowWindow['reading']:
                slowWindow = resetWindow("slow - passage already submitted")
            slowReady = (massRear == 1 and slowPassage is not None and not slowPassage.authorized
                         and not slowPassage.uncertain and slowPassage.pending_id is None
                         and datetime.now() >= slowPassage.retry_at)
            if (context.retrySlowWhileOccupied and slowReady
                    and massRear == 1 and not slowWindow['reading']):
                now = datetime.now()
                slowWindow = readWindow(slowWindow, now + timedelta(milliseconds=slowPre),
                                        now + timedelta(milliseconds=slowPost), "slow - stopped-car retry")
            candidates = checkReadCandidates(
                context, slowWindow, ANTENNA_SLOW, slowMinReads
            ) if slowReady else []
            read = arbitrateCandidates(candidates, lastMass)
            suppressCrossLaneAssignments(context, candidates)
            if read is not None:
                slowWindow = resetWindow(f"slow - read accepted {massTrip}{massMain}{massRear}")
                acceptCandidate(context, read)
                read.update(slowPassage.read_metadata())
                slowPassage.pending_id = read['id']
                sendRead(read)

                #flushReports(ANTENNA_SLOW)
                if LOG_STATS:
                    akiraCore.appendFile(LOG_STATS_FILE,f"lane:{lane} slow: {read['tid']} reads:{read['reads']} {datetime.now().time()}\n")

            #################
            #check for expired windows
            fastExpired = windowExpired(fastWindow)
            slowExpired = windowExpired(slowWindow)
            if fastExpired:
                print(f"lane:{lane} fastExpired used:{fastWindow['used']} end:{fastWindow['end'].time()} {datetime.now().time()}")
                fastWindow = resetWindow("fast - expired")
                #noTag messages
                for driverName, driverModule in readDrivers.items():
                    if DEBUG_DRIVER:
                        print("running driver: " + str(driverName))
                    if hasattr(driverModule, "noTag"):
                        driverModule.noTag(lane, ANTENNA_FAST)
            if slowExpired:
                print(f"lane:{lane} slowExpired used:{slowWindow['used']} end:{slowWindow['end'].time()} {datetime.now().time()}")
                slowWindow = resetWindow("slow - expired")
                if slowReady and not slowPassage.no_tag_shown:
                    for driverModule in readDrivers.values():
                        if hasattr(driverModule, "noTag"):
                            driverModule.noTag(lane, ANTENNA_SLOW)
                    slowPassage.no_tag_shown = True

            #clean old RF events
            cleanOldRf(context, ANTENNA_FAST, fastMaxReportAge)
            cleanOldRf(context, ANTENNA_SLOW, slowMaxReportAge)
            #print(slowMaxReportAge)

            #clean squelch list
            if DEBUG_SQUELCH:
                with context.lock:
                    squelchCount = len(context.squelch)
                if not squelchCount == lastSquelchCount:
                    print(f"squelchCount: {squelchCount}")
                lastSquelchCount = squelchCount
            cleanSquelch(context)

            #see if you need to break lockout
            lockoutChanged, fastWindow, slowWindow = lockoutBreak(
                fastWindow,
                slowWindow,
                lastMass,
                context.clear_debounce_ms,
            )
            if lockoutChanged:
                resetFastValidation(context)
                notifyLaneClear(lane)
                passages.clear()
                debugMass(context, massTrip, massMain, massRear, fastWindow, slowWindow, lastMass)

            syncArbitrationWindowActivity(context, fastWindow, slowWindow)

            #debug read stats
            if DEBUG_READ_MONITOR or LOG_STATS:
                fc, sc = countReports(context)
                fcs = str(fc).rjust(4)
                scs = str(sc).rjust(4)

                if DEBUG_READ_MONITOR:
                    print(f"lane:{lane} {fcs}{scs} {datetime.now().time()}")

                if LOG_STATS:
                    if not lastSc == sc or not lastFc == fc :
                        if fcs == "   0":
                            fcs = "   -"
                        if scs == "   0":
                            scs = "   -"
                        akiraCore.appendFile(LOG_STATS_FILE,f"lane:{lane} {fcs}{scs}  {datetime.now().time()}\n")
                lastFc = fc
                lastSc = sc

        except Exception as ex:
            print(f"laneThread crashed: {ex}")
            traceback.print_exc()
            akiraCore.log(f"laneThread crashed: {ex}")

#######################
def checkReadCandidates(context, window, side, minReads):

    ret = []

    #if no reads don't waste time
    with context.lock:
        reports = list(context.reports)
        if len(reports) == 0:
            return ret

    #print("check " + str(side) + " " + str(len(reports)))

    candidateCount = 0
    candidates = {}

    #print("CR")

    totalCount = 0
    goodCount = 0
    badCount = 0
    badCountPre = 0
    badCountPost = 0
    badCountSide = 0
    blankTidCount = 0

    #if not window['reading']:
    #    print("-")
    #else:
    #    print(len(reports))
        #print("-")
    #if window['reading']:
    #    fc, sc = countReports()
    #    print(f"{fc} - {sc}")

    if window['reading']:
        #print(len(reports))
        for read in reports:
            totalCount = totalCount +1
            #print(f"{read['date']} b:{fast['begin']} e:{fast['end']}")
            if read['date'] > window['begin'] and read['date'] < window['end'] and read['side'] == side:
                goodCount = goodCount +1
                #print(f"cand:{read['tid']}")
                tid = read.get("tid", "")
                if not tid:
                    #print(f"checkReads() blank tid {datetime.now()}")
                    blankTidCount = blankTidCount + 1
                    continue  # ignore blank tids

                rssi = int(read.get("rssi", "-999999"))  # rssi comes in as string like "-538"

                if tid not in candidates:
                    # first time we see this tid in this window
                    candidates[tid] = {
                        "tid": tid,
                        "rssi": rssi,     # highest rssi so far
                        "count": 1,       # times seen
                        "firstSeen": read.get("date"),
                        "lastSeen": read.get("date"),
                        "date": read.get("date"),
                        "reader": readerName,                 # report dict doesn't have reader
                        "lane": read.get("lane"),
                        "side": read.get("side"),
                        "antenna": read.get("antenna"),
                        "rssi": rssi,                         # keep as int or str, your call
                        "reads": 1,                           # will track count
                        "epc": read.get("epc"),
                        "tid": tid,
                        "userData": read.get("userData"),
                        "tidAuthentic": read.get("tidAuthentic"),
                        "pwAuthentic": read.get("pwAuthentic"),
                    }
                else:
                    update = candidates[tid]
                    update["count"] += 1
                    update["lastSeen"] = read.get("date")

                    # update best rssi (less negative = higher)
                    if rssi > update["rssi"]:
                        update["rssi"] = rssi
                        update["bestRead"] = read
                    if not read.get("userData","") == "":
                        update['userData'] = read.get('userData')
                    if read.get('pwAuthentic','') == AUTH_AUTHENTIC:
                        update['pwAuthentic'] = AUTH_AUTHENTIC
                    if read.get('tidAuthentic','') == AUTH_AUTHENTIC:
                        update['tidAuthentic'] = AUTH_AUTHENTIC
            else:
                if read['date'] < window['begin']:
                    badCountPre = badCountPre +1
                if  read['date'] > window['end']:
                    badCountPost = badCountPost +1
                if not read['side'] == side:
                    badCountSide = badCountSide +1
                badCount = badCount +1
                #print(f"read not in scope {read['antenna']} t:{read['date']}")

        #if blankTidCount > 0:
        #    print(f"blank Tid count:{blankTidCount}")

        # Find every qualified candidate. Cross-lane assignment must see the
        # whole pool; choosing one per lane first can accept reciprocal swaps.
        candidateCount = 0
        highestCount = 0

        #if this is a mixed pool
        if len(candidates) > 1 and DEBUG:
            print("******************************")
            print(f"mixed read pool lane:{context.lane}:")
            for tid in candidates:
                poolCount = candidates[tid]["count"]   # or len(...) if you want fields
                print(f"{tid} {poolCount}")
            print("******************************")

        # Check candidates to see if any have enough reads. Authentication
        # behavior remains downstream-compatible with the prior implementation.
        candidateCount = len(candidates)
        if candidates:
            orderedCandidates = sorted(
                candidates.values(),
                key=lambda candidate: (
                    -int(candidate.get("count", 0)),
                    -int(candidate.get("rssi", -999999)),
                    str(candidate.get("tid", "")),
                ),
            )
            highestCount = orderedCandidates[0].get("count", 0)
            qualified = [
                candidate
                for candidate in orderedCandidates
                if candidate.get("count", 0) >= minReads
            ]
            for accepted in qualified:
                accepted['id'] = str(uuid.uuid4())
                accepted['reads'] = accepted['count']
                accepted['otherTids'] = [
                    tid for tid in candidates if tid != accepted['tid']
                ]
                if DEBUG:
                    out = f"<<< lane:{context.lane} {side}: {accepted['tid']} count: {accepted['count']} {accepted['tidAuthentic']}"
                    if LOG_EVENTS:
                        akiraCore.appendFile(LOG_EVENTS_FILE,out + '\n')
                    print(out)
            ret = qualified

    if DEBUG_READ_SEEK:
        if not ret and candidateCount > 0:
            print("CR: ",f"{side} {candidateCount} {highestCount}", end="\r", flush=True)
            #print(f"cr {side} {candidateCount} {highestCount}")

    #if not ret == None:
    #    print('\n')

    # return
    return ret


def checkReads(context, window, side, minReads):
    """Compatibility helper returning the strongest qualified candidate."""
    candidates = checkReadCandidates(context, window, side, minReads)
    return candidates[0] if candidates else None


#######################
def squelchTidBothSides(context, tid, duration=SQUELCH_TIME):
    addSquelch(context, tid, ANTENNA_FAST, duration)
    addSquelch(context, tid, ANTENNA_SLOW, duration)


#######################
def rejectCrossLaneCandidate(context, read):
    """Remove only the losing TID so this lane can reconsider its pool."""
    assignmentMs = max(1, int(tagArbiter.assignment_seconds * 1000))
    squelchTidBothSides(context, read['tid'], assignmentMs)


#######################
def suppressCrossLaneAssignments(context, candidates):
    for read in candidates:
        winnerLane = tagArbiter.assignedLane(read.get('tid'))
        if winnerLane is None or winnerLane == context.lane:
            continue
        rejectCrossLaneCandidate(context, read)
        logCrossLaneSuppression(read)


#######################
def acceptCandidate(context, read):
    """Squelch only the accepted TID; unrelated tags remain eligible."""
    addSquelch(context, read['tid'], read['side'], SQUELCH_TIME)
    # Discard unrelated evidence from this completed passage without blocking
    # fresh reports for a close-following vehicle.
    for tid in read.get('otherTids', []):
        removeReports(context, tid, read['side'])

#######################
def candidateEvidence(read, lastMass):
    readDate = read.get('date', datetime.now())
    massDate = lastMass.get('updated', readDate)
    try:
        massOffsetMs = abs((readDate - massDate).total_seconds() * 1000)
    except Exception:
        massOffsetMs = 999999999

    return {
        "massActive": any(int(lastMass.get(pin, 0)) == 1 for pin in ("trip", "main", "rear")),
        "massOffsetMs": massOffsetMs,
        "reads": read.get("reads", read.get("count", 0)),
        "rssi": read.get("rssi", -999999),
    }


#######################
def arbitrateCandidates(candidates, lastMass):
    if not candidates:
        return None
    lane = str(candidates[0].get("lane", ""))
    side = str(candidates[0].get("side", ""))
    evidenceByTid = {
        str(read.get("tid", "")): candidateEvidence(read, lastMass)
        for read in candidates
    }
    return tagArbiter.submitPool(lane, side, candidates, evidenceByTid)


#######################
def arbitrateCandidate(read, lastMass):
    evidence = candidateEvidence(read, lastMass)
    return tagArbiter.submit(read, evidence)


#######################
def logCrossLaneSuppression(read):
    winnerLane = tagArbiter.assignedLane(read.get('tid')) or "unknown"
    msg = (
        f"CROSS LANE SUPPRESS tid:{read.get('tid')} "
        f"lane:{read.get('lane')} winner:{winnerLane} side:{read.get('side')}"
    )
    print(msg)
    akiraCore.log(msg)


#######################
def sendRead(read):

    #drivers and transaction
    for driverName, driverModule in readDrivers.items():
        if DEBUG_DRIVER:
            print("running driver: " + str(driverName))
        if hasattr(driverModule, "read"):
            driverModule.read(read)

    #trans
    transaction(read['date'], read['reader'], read['lane'], read['side'], read['antenna'], read['rssi'], read['reads'], read['epc'], read['tid'], read['userData'], read['tidAuthentic'], read['pwAuthentic'])


#######################
def removeReports(context, tid, side):
    with context.lock:
        context.reports[:] = [
            r for r in context.reports
            if not (r.get("tid") == tid and r.get("side") == side)
        ]

#######################
def addSquelch(context, tid, side, duration, refresh=False):

    if SQUELCH_DISABLE:
        return

    with context.lock:
        alreadySquelched = isSquelched(context, tid, side)
        if alreadySquelched and refresh:
            for entry in context.squelch:
                if entry['tid'] == tid and entry['side'] == side:
                    entry['end'] = datetime.now() + timedelta(milliseconds=duration)
            return

    if not alreadySquelched:

        end = datetime.now() + timedelta(milliseconds=duration)

        newSquelch = {'tid':tid, 'side':side, 'end':end}

        with context.lock:
            context.squelch.append(newSquelch)

        #clean reports of this tag on this side
        removeReports(context, tid, side)

        if LOG_STATS and DEBUG_SQUELCH:
            akiraCore.appendFile(LOG_STATS_FILE,f"lane:{context.lane} squelch: {tid}\n")

        if DEBUG_SQUELCH:
            print(f"squelched: {tid} {side} {end} {datetime.now()}")


#######################
def cleanSquelch(context):
    now = datetime.now()
    with context.lock:
        context.squelch[:] = [
            s for s in context.squelch
            if s.get("end") >= now
        ]

#######################
def isSquelched(context, tid, side):

    now = datetime.now()
    with context.lock:
        # RF routing runs in a different thread from lane maintenance. Enforce
        # expiry here so a delayed lane loop cannot extend a squelch interval.
        context.squelch[:] = [
            squelch
            for squelch in context.squelch
            if squelch.get("end", now) >= now
        ]
        for s in context.squelch:
            if (
                s.get("tid") == tid and
                s.get("side") == side
            ):
                return True
    return False

#######################
def flushReports(context, side):
    with context.lock:
        context.reports[:] = [r for r in context.reports if r.get("side") != side]
    #end = len(reports)

    #print(f"flushReports: {start} -> {end}")

#######################
def windowExpired(window):

    ret = False

    if window['reading']:
        if datetime.now() > window['end']:
            ret = True

    return ret

#######################
def readWindow(window, begin, end, name = ""):

    if DEBUG_WINDOW:
        print(f"window read: {name} {datetime.now()}")
    window['locked'] = True
    window['reading'] = True
    window['begin'] = begin
    window['end'] = end
    window['used'] = False
    window['usedBy'] = ""
    window['updated'] = datetime.now()

    return window

#######################
def lockWindow(name = ""):

    if DEBUG_WINDOW:
        print(f"window lock: {name} {datetime.now()}")
    window = {}
    window['locked'] = True
    window['reading'] = False
    window['begin'] = datetime.now()
    window['end'] = datetime.now()
    window['used'] = False
    window['usedBy'] = ""
    window['updated'] = datetime.now()

    return window

#######################
def resetWindow(name = ""):

    if DEBUG_WINDOW:
        print(f"window reset: {name} {datetime.now()}")
    window = {}
    window['locked'] = False
    window['reading'] = False
    window['begin'] = datetime.now()
    window['end'] = datetime.now()
    window['used'] = False
    window['usedBy'] = ""
    window['updated'] = datetime.now()

    return window

#######################
def countReports(context):
    fc = 0
    sc = 0
    with context.lock:
        reports = list(context.reports)
    for r in reports:
        if r['side'] == ANTENNA_FAST:
            fc = fc +1
        if r['side'] == ANTENNA_SLOW:
            sc = sc + 1

    return fc, sc

#######################
def debugMass(context, massTrip, massMain, massRear, fastWindow, slowWindow, lastMass):

    fc = 0
    sc = 0

    fastBegin = fastWindow['begin'].time()
    fastEnd = fastWindow['end'].time()
    fastUpdated = fastWindow['updated'].time()
    slowBegin = slowWindow['begin'].time()
    slowEnd = slowWindow['end'].time()
    slowUpdated = slowWindow['updated'].time()
    #print(f"FAST b:{fastBegin} e:{fastEnd} u:{fastUpdated} l:{fastWindow['locked']} r:{fastWindow['reading']}")
    #print(f"SLOW b:{slowBegin} e:{slowEnd} u:{slowUpdated} l:{slowWindow['locked']} r:{slowWindow['reading']}")

    out = f"lane:{context.lane} " + str(massTrip) + " " + str(massMain) + " " + str(massRear) + " "
    if fastWindow['reading']:
        #print(f"{fastWindow['end']} {datetime.now()}")
        if fastWindow['end'] > datetime.now():
            out = out + "R"
        else:
            out = out + "x"
    else:
        out = out + "-"
    if fastWindow['locked']:
        out = out + "L"
    else:
        out = out + "-"
    out = out + " "
    if slowWindow['reading']:
        if slowWindow['end'] > datetime.now():
            out = out + "R"
        else:
            out = out + "x"
    else:
        out = out + "-"
    if slowWindow['locked']:
        out = out + "L"
    else:
        out = out + "-"

    fc, sc = countReports(context)
    out = out + " " + str(fc).rjust(3) + " " + str(sc).rjust(3) + " " + str(datetime.now().time())
    out = out + f" ({fastBegin}-{fastEnd} {slowBegin}-{slowEnd})"
    print(out)

    if LOG_STATS:
        akiraCore.appendFile(LOG_STATS_FILE,out + '\n')

    if LOG_EVENTS:
        akiraCore.appendFile(LOG_EVENTS_FILE,out + '\n')

    if massTrip == 0 and massMain == 0 and massRear == 0:
        print('')

#######################
def cleanOldRf(context, side, maxAge):
    cutoff = datetime.now() - timedelta(milliseconds=maxAge)
    with context.lock:
        context.reports[:] = [
            r for r in context.reports
            if not (
                r.get("side") == side and
                isinstance(r.get("date"), datetime) and
                r["date"] < cutoff
            )
        ]

#######################
def lockoutBreak(
    fastWindow,
    slowWindow,
    lastMass,
    clearDebounceMs=massSensor.DEFAULT_CLEAR_DEBOUNCE_MS,
):
    changed = False

    if lastMass["unlockLockout"] and massClearReady(lastMass, clearDebounceMs):
        fastWindow = resetWindow("fast - lane clear")
        slowWindow = resetWindow("slow - lane clear")
        lastMass["unlockLockout"] = False
        lastMass["lastUnlocked"] = datetime.now()
        changed = True

    return changed, fastWindow, slowWindow


############################################
def normalizedLane(value):
    return str(value).strip()


#######################
def configureReader(reader_name):
    global readerName
    global readerIp
    global readerLanes
    global laneContexts
    global antennaMap
    global antennas
    global tagFilter
    global power
    global frequency
    global auth
    global authWait
    global tidWait
    global mode
    global region
    global fastMaxReportAge
    global fastMinReads
    global slowMaxReportAge
    global slowMinReads
    global fastPre
    global fastPost
    global slowPre
    global slowPost
    global massReconnectSeconds
    global readerReconnectFatalSeconds
    global tagArbiter

    configuredReaders = akiraCore.backupReaders if getSwitchFile() else akiraCore.readers
    matches = [reader for reader in configuredReaders if reader.get('name') == reader_name]
    if len(matches) != 1:
        source = "backupReaders" if getSwitchFile() else "readers"
        raise ValueError(
            f"reader {reader_name!r} must appear exactly once in {source}; found {len(matches)}"
        )

    reader = matches[0]
    configuredLanes = reader.get('lanes')
    if configuredLanes is None:
        configuredLanes = [reader.get('lane')]
    readerLanes = [normalizedLane(value) for value in configuredLanes if normalizedLane(value)]
    if not readerLanes or len(readerLanes) != len(set(readerLanes)):
        raise ValueError(f"reader {reader_name} has missing or duplicate lanes: {readerLanes}")

    antennas = reader.get('antennas', [])
    antennaMap = {}
    laneSides = {lane: set() for lane in readerLanes}
    for antenna in antennas:
        number = str(antenna.get('number', '')).strip()
        antennaLane = normalizedLane(antenna.get('lane', ''))
        side = str(antenna.get('side', '')).strip().lower()
        if not number or number in antennaMap:
            raise ValueError(f"reader {reader_name} has a missing or duplicate antenna number {number!r}")
        if antennaLane not in laneSides:
            raise ValueError(f"antenna {number} maps to unconfigured lane {antennaLane!r}")
        if side not in (ANTENNA_FAST, ANTENNA_SLOW):
            raise ValueError(f"antenna {number} has invalid side {side!r}")
        antennaMap[number] = {"lane": antennaLane, "side": side}
        laneSides[antennaLane].add(side)

    for configuredLane, sides in laneSides.items():
        missingSides = {ANTENNA_FAST, ANTENNA_SLOW} - sides
        if missingSides:
            raise ValueError(
                f"reader {reader_name} lane {configuredLane} lacks antenna side(s): "
                + ", ".join(sorted(missingSides))
            )

    massByLane = {}
    for mass in akiraCore.massSensors:
        massLane = normalizedLane(mass.get('lane', ''))
        if massLane in readerLanes:
            if massLane in massByLane:
                raise ValueError(f"reader {reader_name} has more than one mass sensor for lane {massLane}")
            for required in ('name', 'ip'):
                if str(mass.get(required, '')).strip() == '':
                    raise ValueError(f"mass sensor for lane {massLane} lacks {required}")
            try:
                massByLane[massLane] = massSensor.normalizeConfig(mass)
            except ValueError as ex:
                raise ValueError(f"invalid mass sensor for lane {massLane}: {ex}") from ex

    missingMass = [configuredLane for configuredLane in readerLanes if configuredLane not in massByLane]
    if missingMass:
        raise ValueError(f"reader {reader_name} lacks mass sensors for lanes: {', '.join(missingMass)}")

    laneContexts = {
        configuredLane: LaneContext(configuredLane, massByLane[configuredLane])
        for configuredLane in readerLanes
    }

    readerName = reader_name
    readerIp = str(reader.get('ip', '')).strip()
    if not readerIp:
        raise ValueError(f"reader {reader_name} lacks ip")
    tagFilter = reader.get("tagFilter", "")
    power = str(reader.get('power', '')).strip()
    frequency = str(reader.get('frequency', '')).strip()
    if not power:
        raise ValueError(f"reader {reader_name} lacks power")
    if not frequency:
        raise ValueError(f"reader {reader_name} lacks frequency")
    frequencyTokens = frequency.split()
    if any(not token.isdigit() for token in frequencyTokens):
        raise ValueError(
            f"reader {reader_name} frequency must be a space-separated list of kHz values"
        )
    if len(frequencyTokens) != len(set(frequencyTokens)):
        raise ValueError(f"reader {reader_name} frequency contains duplicate values")
    profileName = str(reader.get("profileName", "AkiraSLFF"))
    if re.fullmatch(r"[A-Za-z0-9_.-]+", profileName) is None:
        raise ValueError(f"reader {reader_name} has invalid profileName {profileName!r}")
    auth = reader.get("auth", True)
    authWait = reader.get("authWait", True)
    tidWait = reader.get("tidWait", True)
    mode = reader.get("mode", "C1G2_MODE_640_MILLER2")
    region = str(reader.get("region", "")).strip()
    if not region:
        raise ValueError(f"reader {reader_name} lacks region")
    fastMaxReportAge = int(reader.get("fastMaxReportAge", "5000"))
    fastMinReads = int(reader.get("fastMinReads", "5"))
    slowMaxReportAge = int(reader.get("slowMaxReportAge", "5000"))
    slowMinReads = int(reader.get("slowMinReads", "5"))
    fastPre = int(reader.get("fastPre", "0"))
    fastPost = int(reader.get("fastPost", "0"))
    slowPre = int(reader.get("slowPre", "0"))
    slowPost = int(reader.get("slowPost", "0"))
    massReconnectSeconds = max(1, int(reader.get("massReconnectSeconds", "10")))
    readerReconnectFatalSeconds = max(
        10,
        int(reader.get("readerReconnectFatalSeconds", "60")),
    )

    if fastMinReads < 1 or slowMinReads < 1:
        raise ValueError("reader minimum read counts must be positive")
    if fastMaxReportAge < 1 or slowMaxReportAge < 1:
        raise ValueError("reader maximum report ages must be positive")
    if fastPost <= fastPre:
        raise ValueError("reader fastPost must be greater than fastPre")
    if slowPost <= slowPre:
        raise ValueError("reader slowPost must be greater than slowPre")

    try:
        arbitrationMs = int(reader.get("crossLaneArbitrationMs", 150))
        assignmentMs = int(reader.get("crossLaneSquelchMs", SQUELCH_TIME))
        massToleranceMs = int(reader.get("crossLaneMassToleranceMs", 10))
    except (TypeError, ValueError) as ex:
        raise ValueError("reader cross-lane timing values must be integers") from ex
    if arbitrationMs < 0 or assignmentMs < 1 or massToleranceMs < 0:
        raise ValueError("reader cross-lane timing values are outside their valid range")
    tagArbiter = CrossLaneArbiter(
        arbitrationMs,
        assignmentMs,
        massToleranceMs,
    )
    return reader

############################################
# thread control

#######################
def startThreads(initialEventConnection, linkHealth):

    stop_event = threading.Event()

    tRecv = threading.Thread(
        target=rfThread,
        args=(stop_event, initialEventConnection, linkHealth),
        name="rfThread",
        daemon=True,
    )
    tDispatch = threading.Thread(target=rfDispatchThread, args=(stop_event,), name="rfDispatchThread", daemon=True)
    tResponses = threading.Thread(target=driverResponseThread, args=(stop_event,), name="driverResponseThread", daemon=True)

    threads = [tRecv, tDispatch, tResponses]
    for context in laneContexts.values():
        threads.append(threading.Thread(
            target=massThread,
            args=(context, stop_event),
            name=f"massThread-{context.lane}",
            daemon=True,
        ))
        threads.append(threading.Thread(
            target=laneThread,
            args=(context, stop_event),
            name=f"laneThread-{context.lane}",
            daemon=True,
        ))

    for thread in threads:
        thread.start()

    return stop_event, tuple(threads)

#######################
def stopThreads(stop_event, threads):

    stop_event.set()
    closeActiveEventConnection()

    # unblock queues
    try:
        rfQ.put_nowait(STOP)
    except Exception:
        pass

    for context in laneContexts.values():
        try:
            context.massQ.put_nowait(STOP)
        except Exception:
            pass
        try:
            context.responseQ.put_nowait(STOP)
        except Exception:
            pass

    shutdownDeadline = time.monotonic() + 6.0
    for t in threads:
        remaining = shutdownDeadline - time.monotonic()
        if remaining <= 0:
            break
        t.join(timeout=remaining)

    remainingWorkers = [thread.name for thread in threads if thread.is_alive()]
    if remainingWorkers:
        akiraCore.log(
            "reader shutdown left worker(s) running: " + ", ".join(remainingWorkers)
        )


def deadWorkerNames(threads):
    return [thread.name for thread in threads if not thread.is_alive()]


############################################
def runSelfTests():
    global DEBUG
    global LOG_EVENTS
    global LOG_STATS
    DEBUG = False
    LOG_EVENTS = False
    LOG_STATS = False

    if not readerLanes or set(readerLanes) != set(laneContexts):
        raise AssertionError("configured lanes and lane contexts differ")
    if not antennaMap:
        raise AssertionError("reader has no configured antennas")

    laneFastAntennas = {}
    for lane in readerLanes:
        fastAntennas = [
            number
            for number, assignment in antennaMap.items()
            if assignment == {"lane": lane, "side": ANTENNA_FAST}
        ]
        if not fastAntennas:
            raise AssertionError(f"lane {lane} has no fast antenna")
        laneFastAntennas[lane] = sorted(fastAntennas)[0]
        context = laneContexts[lane]
        if context.lane != lane:
            raise AssertionError(f"lane context identity mismatch for {lane}")
        try:
            numericLane = int(lane)
        except ValueError:
            numericLane = None
        if numericLane is not None and getLaneContext(numericLane) is not context:
            raise AssertionError(f"numeric lane {numericLane} did not resolve to {lane}")

    for context in laneContexts.values():
        context.reports = []
    for index, lane in enumerate(readerLanes):
        antenna = laneFastAntennas[lane]
        tid = f"ROUTE{index}"
        parseEvent(
            f"event.tag.report tag_id=0xEPC{index}, time=0, antenna={antenna}, "
            f"rssi={-500 + index}, tid=0x{tid}, user_data=, "
            "tid_authentic=AUTHENTIC, pw_authentic=AUTHENTIC, freq=919250"
        )
        routedTids = [report.get("tid") for report in laneContexts[lane].reports]
        if routedTids != [tid]:
            raise AssertionError(
                f"antenna {antenna} did not route exclusively to lane {lane}: {routedTids}"
            )

    now = datetime.now()

    def makeReport(lane, tid, rssi=-500):
        return {
            "date": now,
            "reader": readerName,
            "lane": lane,
            "side": ANTENNA_FAST,
            "antenna": laneFastAntennas[lane],
            "rssi": rssi,
            "epc": "EPC-" + tid,
            "tid": tid,
            "userData": "",
            "tidAuthentic": AUTH_AUTHENTIC,
            "pwAuthentic": AUTH_AUTHENTIC,
        }

    for index, lane in enumerate(readerLanes):
        context = laneContexts[lane]
        laneReport = makeReport(lane, f"LANE{index}")
        context.reports = [laneReport, dict(laneReport)]
        window = readWindow(
            resetWindow("self test"),
            now - timedelta(milliseconds=10),
            now + timedelta(milliseconds=10),
            "self test",
        )
        candidate = checkReads(context, window, ANTENNA_FAST, 2)
        if candidate is None or candidate.get("lane") != lane:
            raise AssertionError(f"lane {lane} candidate pool was not isolated")
        if candidate.get("reads") != 2:
            raise AssertionError(f"candidate read count was not propagated: {candidate}")

    # A losing cross-read must not destroy the lane's own second candidate or
    # close its mass window. Accepting a winner must not squelch unrelated TIDs.
    testLane = readerLanes[-1]
    testContext = laneContexts[testLane]
    crossReport = makeReport(testLane, "CROSS", rssi=-430)
    ownReport = makeReport(testLane, "OWN", rssi=-520)
    testContext.reports = [
        crossReport,
        dict(crossReport),
        dict(crossReport),
        ownReport,
        dict(ownReport),
    ]
    testContext.squelch = []
    mixedWindow = readWindow(
        resetWindow("mixed pool self test"),
        now - timedelta(milliseconds=10),
        now + timedelta(milliseconds=1000),
        "mixed pool self test",
    )
    firstMixedCandidate = checkReads(
        testContext, mixedWindow, ANTENNA_FAST, 2
    )
    if firstMixedCandidate is None or firstMixedCandidate.get("tid") != "CROSS":
        raise AssertionError("mixed pool did not select the strongest first candidate")
    if "OWN" not in firstMixedCandidate.get("otherTids", []):
        raise AssertionError("mixed pool did not preserve alternate candidate metadata")
    rejectCrossLaneCandidate(testContext, firstMixedCandidate)
    secondMixedCandidate = checkReads(
        testContext, mixedWindow, ANTENNA_FAST, 2
    )
    if secondMixedCandidate is None or secondMixedCandidate.get("tid") != "OWN":
        raise AssertionError("losing cross-read destroyed the lane's own candidate")
    if not mixedWindow["reading"]:
        raise AssertionError("losing cross-read closed the lane's mass window")
    testContext.squelch = []
    accepted = dict(secondMixedCandidate, otherTids=["NEXT-TID"])
    acceptCandidate(testContext, accepted)
    if isSquelched(testContext, "NEXT-TID", ANTENNA_FAST):
        raise AssertionError("accepting one tag squelched an unrelated fast tag")
    if isSquelched(testContext, "NEXT-TID", ANTENNA_SLOW):
        raise AssertionError("accepting one tag squelched an unrelated slow tag")
    testContext.squelch = [{
        "tid": "EXPIRED-TID",
        "side": ANTENNA_FAST,
        "end": datetime.now() - timedelta(milliseconds=1),
    }]
    if isSquelched(testContext, "EXPIRED-TID", ANTENNA_FAST):
        raise AssertionError("expired squelch remained active until lane maintenance")

    if len(readerLanes) >= 2:
        laneA, laneB = readerLanes[:2]

        # With only one mass-gated lane active, a qualified candidate should
        # claim its lane immediately instead of paying the arbitration delay.
        hybridArbiter = CrossLaneArbiter(arbitration_ms=250, assignment_ms=1000)
        hybridArbiter.setLaneWindowActivity(laneA, True, False)
        hybridArbiter.setLaneWindowActivity(laneB, False, False)
        hybridRead = {
            "tid": "HYBRID-TID",
            "lane": laneA,
            "side": ANTENNA_FAST,
            "reads": 5,
            "rssi": -500,
        }
        hybridStarted = time.monotonic()
        if not hybridArbiter.submit(hybridRead):
            raise AssertionError("uncontested hybrid lane claim was rejected")
        hybridElapsed = time.monotonic() - hybridStarted
        if hybridElapsed >= 0.1:
            raise AssertionError(
                f"uncontested hybrid lane claim blocked for {hybridElapsed:.3f}s"
            )

        # A later observation in the same lane must renew ownership from the
        # newer sighting so a long passage cannot switch lanes mid-vehicle.
        firstHybridExpiry = hybridArbiter.assignments["HYBRID-TID"][1]
        time.sleep(0.002)
        hybridArbiter.setLaneWindowActivity(laneA, False, True)
        if not hybridArbiter.submit(dict(hybridRead, side=ANTENNA_SLOW)):
            raise AssertionError("owning lane's later hybrid read was rejected")
        if hybridArbiter.assignments["HYBRID-TID"][1] <= firstHybridExpiry:
            raise AssertionError("owning lane's later read did not renew TID ownership")
        if hybridArbiter.submit(dict(hybridRead, lane=laneB)):
            raise AssertionError("hybrid ownership did not suppress the other lane")

        arbiter = CrossLaneArbiter(arbitration_ms=25, assignment_ms=1000)
        arbiter.setLaneWindowActivity(laneA, True, False)
        arbiter.setLaneWindowActivity(laneB, True, False)
        barrier = threading.Barrier(3)
        results = {}

        def submitCandidate(lane, reads, rssi, massOffsetMs):
            barrier.wait()
            results[lane] = arbiter.submit(
                {
                    "tid": "SHARED-TID",
                    "lane": lane,
                    "side": ANTENNA_FAST,
                    "reads": reads,
                    "rssi": rssi,
                },
                {
                    "massActive": True,
                    "massOffsetMs": massOffsetMs,
                    "reads": reads,
                    "rssi": rssi,
                },
            )

        arbitrationThreads = [
            threading.Thread(target=submitCandidate, args=(laneA, 5, -520, 30)),
            threading.Thread(target=submitCandidate, args=(laneB, 8, -430, 10)),
        ]
        for thread in arbitrationThreads:
            thread.start()
        barrier.wait()
        for thread in arbitrationThreads:
            thread.join(timeout=2)
        if results != {laneA: False, laneB: True}:
            raise AssertionError(f"cross-lane arbitration chose incorrectly: {results}")
        if arbiter.submit({"tid": "SHARED-TID", "lane": laneA}):
            raise AssertionError("losing lane was not suppressed")
        if not arbiter.submit(
            {"tid": "SHARED-TID", "lane": laneB, "side": ANTENNA_SLOW}
        ):
            raise AssertionError("winning lane's later slow read was incorrectly suppressed")

        # When the two lanes' mass timing differs by less than the configured
        # tolerance, RF strength must not break the tie: antenna bleed can make
        # the wrong lane's read count and RSSI look better.
        nearTieArbiter = CrossLaneArbiter(
            arbitration_ms=25,
            assignment_ms=1000,
            mass_tolerance_ms=10,
        )
        nearTieArbiter.setLaneWindowActivity(laneA, True, False)
        nearTieArbiter.setLaneWindowActivity(laneB, True, False)
        nearTieBarrier = threading.Barrier(3)
        nearTieResults = {}

        def submitNearTie(lane, reads, rssi, massOffsetMs):
            nearTieBarrier.wait()
            nearTieResults[lane] = nearTieArbiter.submit(
                {
                    "tid": "NEAR-TIE-TID",
                    "lane": lane,
                    "side": ANTENNA_FAST,
                    "reads": reads,
                    "rssi": rssi,
                },
                {
                    "massActive": True,
                    "massOffsetMs": massOffsetMs,
                    "reads": reads,
                    "rssi": rssi,
                },
            )

        nearTieThreads = [
            threading.Thread(target=submitNearTie, args=(laneA, 5, -520, 10)),
            threading.Thread(target=submitNearTie, args=(laneB, 12, -350, 17)),
        ]
        for thread in nearTieThreads:
            thread.start()
        nearTieBarrier.wait()
        for thread in nearTieThreads:
            thread.join(timeout=2)
        if nearTieResults != {laneA: False, laneB: False}:
            raise AssertionError(
                f"near-equal cross-lane mass evidence did not fail closed: "
                f"{nearTieResults}"
            )

        # Fast and slow submissions share one global TID arbitration. Opposite
        # sides must not independently accept the same cross-read.
        oppositeArbiter = CrossLaneArbiter(arbitration_ms=25, assignment_ms=1000)
        oppositeArbiter.setLaneWindowActivity(laneA, True, False)
        oppositeArbiter.setLaneWindowActivity(laneB, False, True)
        oppositeBarrier = threading.Barrier(3)
        oppositeResults = {}

        def submitOpposite(lane, side, massOffsetMs):
            oppositeBarrier.wait()
            oppositeResults[(lane, side)] = oppositeArbiter.submit(
                {
                    "tid": "OPPOSITE-SIDE-TID",
                    "lane": lane,
                    "side": side,
                    "reads": 5,
                    "rssi": -500,
                },
                {
                    "massActive": True,
                    "massOffsetMs": massOffsetMs,
                    "reads": 5,
                    "rssi": -500,
                },
            )

        oppositeThreads = [
            threading.Thread(
                target=submitOpposite,
                args=(laneA, ANTENNA_FAST, 40),
            ),
            threading.Thread(
                target=submitOpposite,
                args=(laneB, ANTENNA_SLOW, 5),
            ),
        ]
        for thread in oppositeThreads:
            thread.start()
        oppositeBarrier.wait()
        for thread in oppositeThreads:
            thread.join(timeout=2)
        expectedOpposite = {
            (laneA, ANTENNA_FAST): False,
            (laneB, ANTENNA_SLOW): True,
        }
        if oppositeResults != expectedOpposite:
            raise AssertionError(
                f"opposite-side arbitration chose incorrectly: {oppositeResults}"
            )
        if oppositeArbiter.assignedLane("OPPOSITE-SIDE-TID") != laneB:
            raise AssertionError("opposite-side TID ownership did not match its winner")

        # Global arbitration must not serialize unrelated traffic. Different
        # TIDs in opposite lane/side slots can both be accepted.
        independentArbiter = CrossLaneArbiter(arbitration_ms=25, assignment_ms=1000)
        independentBarrier = threading.Barrier(3)
        independentResults = {}

        def submitIndependent(lane, side, tid):
            independentBarrier.wait()
            independentResults[(lane, side)] = independentArbiter.submit(
                {
                    "tid": tid,
                    "lane": lane,
                    "side": side,
                    "reads": 5,
                    "rssi": -500,
                },
                {
                    "massActive": True,
                    "massOffsetMs": 5,
                    "reads": 5,
                    "rssi": -500,
                },
            )

        independentThreads = [
            threading.Thread(
                target=submitIndependent,
                args=(laneA, ANTENNA_FAST, "INDEPENDENT-A"),
            ),
            threading.Thread(
                target=submitIndependent,
                args=(laneB, ANTENNA_SLOW, "INDEPENDENT-B"),
            ),
        ]
        for thread in independentThreads:
            thread.start()
        independentBarrier.wait()
        for thread in independentThreads:
            thread.join(timeout=2)
        if independentResults != {
            (laneA, ANTENNA_FAST): True,
            (laneB, ANTENNA_SLOW): True,
        }:
            raise AssertionError(
                f"unrelated opposite-side tags were blocked: {independentResults}"
            )

        # Reciprocal mixed pools must be solved together. Mass timing outranks
        # misleading cross-lane read count and produces one tag per lane.
        poolArbiter = CrossLaneArbiter(arbitration_ms=25, assignment_ms=1000)
        poolBarrier = threading.Barrier(3)
        poolResults = {}
        tagA = "POOL-A"
        tagB = "POOL-B"
        pools = {
            laneA: [
                dict(makeReport(laneA, tagA, -500), reads=4, count=4),
                dict(makeReport(laneA, tagB, -420), reads=6, count=6),
            ],
            laneB: [
                dict(makeReport(laneB, tagA, -420), reads=6, count=6),
                dict(makeReport(laneB, tagB, -500), reads=4, count=4),
            ],
        }
        poolEvidence = {
            laneA: {
                tagA: {"massActive": True, "massOffsetMs": 5, "reads": 4, "rssi": -500},
                tagB: {"massActive": True, "massOffsetMs": 80, "reads": 6, "rssi": -420},
            },
            laneB: {
                tagA: {"massActive": True, "massOffsetMs": 80, "reads": 6, "rssi": -420},
                tagB: {"massActive": True, "massOffsetMs": 5, "reads": 4, "rssi": -500},
            },
        }

        def submitPool(lane):
            poolBarrier.wait()
            winner = poolArbiter.submitPool(
                lane, ANTENNA_FAST, pools[lane], poolEvidence[lane]
            )
            poolResults[lane] = winner.get("tid") if winner else None

        poolThreads = [
            threading.Thread(target=submitPool, args=(lane,))
            for lane in (laneA, laneB)
        ]
        for thread in poolThreads:
            thread.start()
        poolBarrier.wait()
        for thread in poolThreads:
            thread.join(timeout=2)
        if poolResults != {laneA: tagA, laneB: tagB}:
            raise AssertionError(f"passage-level arbitration swapped tags: {poolResults}")

        # Do not sacrifice the strongest mutual lane/TID choice just to fill a
        # second lane. Here lane A clearly owns X; lane B's cross-read of X must
        # not force lane A onto its weak fallback Y.
        asymmetricArbiter = CrossLaneArbiter(
            arbitration_ms=25,
            assignment_ms=1000,
            mass_tolerance_ms=10,
        )
        asymmetricArbiter.setLaneWindowActivity(laneA, True, False)
        asymmetricArbiter.setLaneWindowActivity(laneB, True, False)
        asymmetricBarrier = threading.Barrier(3)
        asymmetricResults = {}
        asymmetricX = "ASYMMETRIC-X"
        asymmetricY = "ASYMMETRIC-Y"
        asymmetricPools = {
            laneA: [
                dict(makeReport(laneA, asymmetricX, -350), reads=20, count=20),
                dict(makeReport(laneA, asymmetricY, -650), reads=5, count=5),
            ],
            laneB: [
                dict(makeReport(laneB, asymmetricX, -650), reads=5, count=5),
            ],
        }
        asymmetricEvidence = {
            laneA: {
                asymmetricX: {
                    "massActive": True,
                    "massOffsetMs": 5,
                    "reads": 20,
                    "rssi": -350,
                },
                asymmetricY: {
                    "massActive": True,
                    "massOffsetMs": 200,
                    "reads": 5,
                    "rssi": -650,
                },
            },
            laneB: {
                asymmetricX: {
                    "massActive": True,
                    "massOffsetMs": 180,
                    "reads": 5,
                    "rssi": -650,
                },
            },
        }

        def submitAsymmetricPool(lane):
            asymmetricBarrier.wait()
            winner = asymmetricArbiter.submitPool(
                lane,
                ANTENNA_FAST,
                asymmetricPools[lane],
                asymmetricEvidence[lane],
            )
            asymmetricResults[lane] = winner.get("tid") if winner else None

        asymmetricThreads = [
            threading.Thread(target=submitAsymmetricPool, args=(lane,))
            for lane in (laneA, laneB)
        ]
        for thread in asymmetricThreads:
            thread.start()
        asymmetricBarrier.wait()
        for thread in asymmetricThreads:
            thread.join(timeout=2)
        if asymmetricResults != {laneA: asymmetricX, laneB: None}:
            raise AssertionError(
                f"asymmetric arbitration displaced the strongest match: "
                f"{asymmetricResults}"
            )

        ambiguousArbiter = CrossLaneArbiter(arbitration_ms=25, assignment_ms=1000)
        ambiguousBarrier = threading.Barrier(3)
        ambiguousResults = {}
        ambiguousEvidence = {
            lane: {
                tid: dict(evidence, massOffsetMs=0)
                for tid, evidence in poolEvidence[lane].items()
            }
            for lane in (laneA, laneB)
        }

        def submitAmbiguousPool(lane):
            ambiguousBarrier.wait()
            winner = ambiguousArbiter.submitPool(
                lane, ANTENNA_FAST, pools[lane], ambiguousEvidence[lane]
            )
            ambiguousResults[lane] = winner.get("tid") if winner else None

        ambiguousThreads = [
            threading.Thread(target=submitAmbiguousPool, args=(lane,))
            for lane in (laneA, laneB)
        ]
        for thread in ambiguousThreads:
            thread.start()
        ambiguousBarrier.wait()
        for thread in ambiguousThreads:
            thread.join(timeout=2)
        if ambiguousResults != {laneA: None, laneB: None}:
            raise AssertionError(
                f"ambiguous reciprocal tags were not rejected: {ambiguousResults}"
            )

    class FragmentedSocket:
        def __init__(self, chunks):
            self.chunks = list(chunks)

        def settimeout(self, timeout):
            pass

        def recv(self, size):
            return self.chunks.pop(0) if self.chunks else b""

        def shutdown(self, how):
            pass

        def close(self):
            pass

    frames = [
        b"event.tag.report antenna=1 tid=ONE\r\n",
        b"\r\nevent.tag.report antenna=3 tid=TWO\r\n\r\n",
    ]
    framedConnection = DelimitedReaderConnection(
        "test",
        0,
        socket_factory=lambda address, timeout: FragmentedSocket(frames),
    )
    if framedConnection.readFrame() != "event.tag.report antenna=1 tid=ONE":
        raise AssertionError("fragmented reader event was not reassembled")
    if framedConnection.readFrame() != "event.tag.report antenna=3 tid=TWO":
        raise AssertionError("combined reader events were not separated")

    class SilentSocket(FragmentedSocket):
        def __init__(self):
            super().__init__([])

        def recv(self, size):
            raise socket.timeout()

    silentConnection = DelimitedReaderConnection(
        "silent-test",
        0,
        socket_factory=lambda address, timeout: SilentSocket(),
    )
    try:
        silentConnection.readFrame(timeout=0.02)
    except TimeoutError:
        pass
    else:
        raise AssertionError("silent reader handshake did not honor its deadline")

    lockName = "self-test-" + str(uuid.uuid4())
    firstLock = acquireReaderProcessLock(lockName)
    try:
        try:
            acquireReaderProcessLock(lockName)
        except RuntimeError:
            pass
        else:
            raise AssertionError("duplicate reader process lock was accepted")
    finally:
        firstLock.close()

    gpioState = parseGpio("gpio readall = FF8E")
    if gpioState is None or len(gpioState) != 16:
        raise AssertionError("Numato readall state was not parsed")
    fragmentedReplyState = parseGpio("Logged in successfully\r\n\r\n>FF80\x00\r\n>")
    if fragmentedReplyState != parseGpio("FF80"):
        raise AssertionError("Numato fragmented readall response was not parsed")
    if parseGpio("Logged in successfully") is not None:
        raise AssertionError("Numato response text was incorrectly parsed as GPIO state")
    sensorConfig = laneContexts[readerLanes[0]].mass_config
    getMassStates(gpioState, sensorConfig)

    clearValue = 1 - sensorConfig["activeState"]
    rawClear = {str(port + 100): clearValue for port in range(16)}
    clearState = massSensor.logicalState(rawClear, sensorConfig)
    if any(clearState[key] for key in ("fast", "mid", "slow", "occupied")):
        raise AssertionError("clear GPIO inputs produced occupied logical mass state")

    compatibilityRole = {"fast": "trip", "mid": "main", "slow": "rear"}
    for role, ports in sensorConfig["ports"].items():
        for port in ports:
            rawActive = dict(
                rawClear,
                **{str(port + 100): sensorConfig["activeState"]},
            )
            activeState = massSensor.logicalState(rawActive, sensorConfig)
            if activeState[role] != 1 or activeState[compatibilityRole[role]] != 1:
                raise AssertionError(
                    f"configured physical port {port} did not trigger {role}"
                )

    clearTracking = {
        "trip": 0,
        "main": 0,
        "rear": 0,
        "clearSince": now,
    }
    if massClearReady(clearTracking, sensorConfig["clearDebounceMs"], now=now):
        raise AssertionError("lane cleared before mass debounce elapsed")
    afterDebounce = now + timedelta(milliseconds=sensorConfig["clearDebounceMs"] + 1)
    if not massClearReady(clearTracking, sensorConfig["clearDebounceMs"], now=afterDebounce):
        raise AssertionError("lane did not clear after mass debounce elapsed")
    clearTracking["main"] = 1
    if massClearReady(clearTracking, sensorConfig["clearDebounceMs"], now=afterDebounce):
        raise AssertionError("active middle sensor incorrectly allowed lane clear")

    print("PASS: reader isolation, passage arbitration, framing, and mass mapping")

############################################################################################
# main

CONFIGURE = True

if len(sys.argv) < 2:
    print(f"Usage: {sys.argv[0]} <reader-name> [--validate-config]", file=sys.stderr)
    raise SystemExit(2)

readerName = sys.argv[1]

try:
    reader = configureReader(readerName)
except Exception as ex:
    akiraCore.log(f"Reader {readerName} configuration error: {ex}")
    print(f"Reader {readerName} configuration error: {ex}", file=sys.stderr)
    raise SystemExit(2)

if "--validate-config" in sys.argv:
    print(
        f"VALID reader {readerName}: lanes={','.join(readerLanes)} "
        f"antennas={len(antennaMap)} massSensors={len(laneContexts)}"
    )
    raise SystemExit(0)

if "--self-test" in sys.argv:
    runSelfTests()
    raise SystemExit(0)

try:
    acquireReaderProcessLock(readerName)
except RuntimeError as ex:
    akiraCore.log(str(ex))
    print(str(ex), file=sys.stderr)
    raise SystemExit(3)

akiraCore.log("Reader " + readerName + " Starting")

print(fastPre)
print(fastPost)
print(slowPre)
print(slowPost)

if DEBUG:
        print("Reader " + readerName + " Starting")
        print("IP: " + str(readerIp))
        print("Lanes: " + ",".join(readerLanes))

initialEventConnection = None
stop_event = None
threads = ()
linkHealth = ReaderLinkHealth()
shutdownRequested = threading.Event()
exitCode = 0


def requestShutdown(signum, frame):
    shutdownRequested.set()


signal.signal(signal.SIGINT, requestShutdown)
signal.signal(signal.SIGTERM, requestShutdown)

def configureReaderHardware(saveProfile=True):
    connectCommandSocket()
    xrCmd("reader.login(admin, admin)")
    if not CONFIGURE:
        return

    placedInStandby = False
    try:
        xrCmd("reader.login(admin, admin)")
        xrCmd("setup.operating_mode=standby")
        placedInStandby = True

        detectedResponse = xrCmd("antennas.detected")
        detectedAntennas = set(re.findall(r"\d+", detectedResponse[2:]))
        missingAntennas = set(antennaMap) - detectedAntennas
        if missingAntennas:
            raise ReaderCommandError(
                "configured antennas were not detected: "
                + ", ".join(sorted(missingAntennas))
            )

        regionResponse = xrCmd("setup.region")
        actualRegion = regionResponse[2:].strip()
        if actualRegion != region:
            raise ReaderCommandError(
                f"reader region mismatch: configured {region!r}, hardware {actualRegion!r}"
            )

        commands = [
            "reader.timestamp_all_events=True",
            "com.network.ntp.enabled=1",
            "com.network.tcpkeepalive=1",
            "tag.reporting.depart_time=250",
            "tag.reporting.raw_arrive_fields=tag_id time antenna audit_record rssi tid",
            "tag.reporting.arrive_fields=tag_id tid user_data time antenna rssi tid_authentic pw_authentic",
            "tag.reporting.depart_fields=tag_id tid user_data time antenna repeat tid_authentic pw_authentic",
            "tag.reporting.taglist_fields=tag_id time tid user_data time antenna repeat pw_authentic tid_authentic",
            "tag.reporting.report_fields=tag_id tid user_data time antenna rssi tid_authentic pw_authentic freq",
            "setup.advanced.do_opspecs_once=1",
            "antennas.mux_sequence=0",
            "modem.control.cognitive.auto_mux=0",
            "modem.protocol.isoc.control.user_data_length=8",
            "modem.protocol.isoc.control.tid_data_length=6",
            "modem.protocol.isoc.filter.1.action=ASSERT_DEASSERT",
            "modem.protocol.isoc.filter.1.length=8",
            "modem.protocol.isoc.filter.1.mask=B000",
            "modem.protocol.isoc.filter.1.mem_bank=membank_epc",
            "modem.protocol.isoc.filter.1.offset=32",
            "modem.protocol.isoc.filter.1.session=NOT_USED",
            "modem.protocol.isoc.filtering.use_session=false",
            "modem.protocol.isoc.filtering.enabled=1",
            "modem.protocol.isoc.filter.1.enabled=true",
            "modem.protocol.isoc.control.use_block_write=false",
            "modem.protocol.isoc.control.auto_mac.enable=false",
            "modem.protocol.isoc.control.inventory_both_targets=true",
            "modem.protocol.isoc.control.query_sel=0",
            "modem.protocol.isoc.control.query_session=0",
            "modem.protocol.isoc.control.session_id=SESSION_1",
            "modem.protocol.isoc.control.number_slots_q=2",
            "modem.protocol.isoc.control.failsafe=31",
        ]
        for command in commands:
            xrCmd(command)

        authValue = 1 if auth else 0
        xrCmd(f"tag.security.password_authentication_enable={authValue}")
        xrCmd(f"tag.security.tid_authentication_enable={authValue}")
        xrCmd("tag.security.tid_mask.enable=0")
        xrCmd("setup.advanced.preferred_frequencies=" + frequency)
        xrCmd("modem.control.cognitive.lbt_max_hops=8")

        for antenna in antennas:
            antennaNumber = str(antenna['number'])
            antennaPower = str(antenna.get('power', '') or power)
            xrCmd(f"antennas.{antennaNumber}.conducted_power={antennaPower}")

        xrCmd("modem.protocol.isoc.physical.mode=" + str(mode))
        if authWait:
            xrCmd("tag.reporting.arrive_generation=wait_for_all")
        elif tidWait:
            xrCmd("tag.reporting.arrive_generation=wait_for_tid")

        if saveProfile:
            profileName = str(reader.get("profileName", "AkiraSLFF"))
            xrCmd(f"reader.profile.save({profileName})")

        antennasDiag = xrCmd("antennas.diag").replace('\n', '|').replace('\r', '')
        akiraCore.log(
            f"{datetime.now()} reader {readerName} connected to {readerIp} "
            f"antennas.diag: {antennasDiag}"
        )

        if READER_ENABLED:
            xrCmd("setup.operating_mode=active")
            placedInStandby = False
    except Exception:
        if placedInStandby and READER_ENABLED:
            try:
                xrCmd("setup.operating_mode=active")
            except Exception as recoveryError:
                akiraCore.log(
                    f"reader {readerName} failed to restore active mode: {recoveryError}"
                )
        raise


def reconnectReaderEvent(stop_event):
    """Restore an event socket without rewriting a healthy reader profile."""
    connectCommandSocket()
    xrCmd("reader.login(admin, admin)")
    modeResponse = xrCmd("setup.operating_mode")
    modeValue = modeResponse[2:].strip().lower()

    if modeValue != "active":
        # A rebooted or standby reader needs its checked runtime configuration,
        # but the already-saved profile does not need another persistent write.
        configureReaderHardware(saveProfile=False)

    return connectEventConnection(stop_event=stop_event)


try:
    configureReaderHardware()
    initialEventConnection = connectEventConnection(stop_event=shutdownRequested)
    setActiveEventConnection(initialEventConnection)
    linkHealth.markConnected()
    print("----------------------------------------")

    stop_event, threads = startThreads(initialEventConnection, linkHealth)
    while not shutdownRequested.wait(0.5):
        deadWorkers = deadWorkerNames(threads)
        if deadWorkers:
            raise RuntimeError("reader worker stopped: " + ", ".join(deadWorkers))
        disconnectedSeconds = linkHealth.disconnectedFor()
        if disconnectedSeconds >= readerReconnectFatalSeconds:
            raise RuntimeError(
                f"RF link unavailable for {disconnectedSeconds:.1f}s: {linkHealth.error()}"
            )
except Exception as ex:
    exitCode = 1
    msg = f"Reader {readerName} fatal error: {ex}"
    print(msg, file=sys.stderr)
    akiraCore.log(msg)
finally:
    if stop_event is not None:
        stopThreads(stop_event, threads)
    else:
        closeActiveEventConnection()
    closeCommandSocket()

raise SystemExit(exitCode)
