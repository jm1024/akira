def parseEvent(event):

    global arrivals
    global reports
    #global reportsSlow

    vals = event.split(" ")

    #full arrive event
    if vals[0] == "event.tag.arrive":
        #if DEBUG_ARRIVE:
        #    print("+++++++++++++++++++++++++")
        #    print(event)
        #    print("-------------------------")
    
        date = ""
        epc = ""
        antenna = ""
        rssi = ""
        tid = ""
        userData = ""
        tidAuthentic = ""
        pwAuthentic = ""
    
        for val in vals:
            d = val.split('=')
            if d[0] == "first":
                date = d[1].strip(',')
            if d[0] == "tag_id":
                epc = d[1][2:]
                epc = epc.strip(',')
            if d[0] == "antenna":
                antenna = d[1].strip(',')
            if d[0] == "rssi":
                rssi = d[1]
                rssi = rssi.strip(',')
            if d[0] == "tid":
                tid = d[1]
                tid = tid.strip(',')
                if tid.startswith("0x"): #strip leading hex stuff
                    tid = tid[2:]
            if d[0] == "user_data":
                    userData = d[1]
                    userData = userData.strip(',')
            if d[0] == "tid_authentic":
                tidAuthentic = d[1]
                tidAuthentic = tidAuthentic.strip(',')
            if d[0] == "pw_authentic":
                pwAuthentic = d[1]
                pwAuthentic = pwAuthentic.strip(',')
    
        try:
            if len(tid) > 24:
                #print("reader: trim: " +str(tid))
                tid = tid[:24]
                #print("reader: done: " +str(tid))
        except Exception as ex:
            print("ERROR: reader: truncating tid: " + str(ex))
    
        arrival = {'date':date, 'antenna':antenna, 'rssi':rssi, 'tid':tid, 'userData':userData, 'tidAuthentic':tidAuthentic, 'pwAuthentic':pwAuthentic}
    
    
        if DEBUG_ARRIVE:
            output = "==============================================="
            output = output + "\n" + str(date)
            output = output + "\n ant: " + str(antenna)
            output = output + " epc: " + str(epc)    
            output = output + "\n tid: " + str(tid)
            output = output + " user: "+  str(userData)
            output = output + "\n auth: " + str(pwAuthentic)
            output = output + " rssi: "+  str(rssi)
            output = output + "\n--------------------------------------------"
            print(output)
    
        arrivals[epc] = arrival
        
        #driver for fast read transmits to other systems
        #dt, reader, lane, side, antenna, rssi, epc, tid, userData, tidAuthentic, pwAuthentic
        lane = 0
        side = "unknown"
        id = str(uuid.uuid4())
        for thisAntenna in antennas:
            if str(thisAntenna.get('number')) == str(antenna):
                lane = thisAntenna.get('lane')
                side = thisAntenna.get('side')
        arrival['id'] = id
        arrival['lane'] = lane
        arrival['side'] = side
        
        dtDate = sidraCore.rfStrToDt(date)
        
        report = {'date':dtDate, 'antenna':antenna, 'rssi':rssi, 'epc':epc, 'tid':tid, 'userData':userData, 'tidAuthentic':tidAuthentic, 'pwAuthentic':pwAuthentic}
        
        #driver for fast read transmits to other systems
        #dt, reader, lane, side, antenna, rssi, epc, tid, userData, tidAuthentic, pwAuthentic
        lane = 0
        side = "unknown"
        id = str(uuid.uuid4())
        for thisAntenna in antennas:
            if str(thisAntenna.get('number')) == str(antenna):
                lane = thisAntenna.get('lane')
                side = thisAntenna.get('side')
        report['id'] = id
        report['lane'] = lane
        report['side'] = side
        
        # if squelched don't add
        if isSquelched(tid, side):
            if DEBUG_SQUELCH:
                print(f" is squelched {tid} {side}")
        else:
            #add to appropriate list
            
            #print(f"addArrive {report['tid']} {report['side']}")
            reports.append(report)    

    ##################################################################
    # report event
    if vals[0] == "event.tag.report":
        
        if DEBUG_REPORT:
        #    print("+++++++++++++++++++++++++")
            print(event)
        #    print("-------------------------")
    
        date = ""
        epc = ""
        antenna = ""
        rssi = ""
        tid = ""
        userData = ""
        tidAuthentic = ""
        pwAuthentic = ""
    
        for val in vals:
            d = val.split('=')
            if d[0] == "time":
                sDate = d[1].strip(',')
            if d[0] == "tag_id":
                try:
                    epc = d[1][2:]
                    epc = epc.strip(',')
                except:
                    print("BAD TID")
                    return
            if d[0] == "antenna":
                antenna = d[1].strip(',')
            if d[0] == "rssi":
                rssi = d[1]
                rssi = rssi.strip(',')
            if d[0] == "tid":
                tid = d[1]
                tid = tid.strip(',')
                if tid.startswith("0x"): #strip leading hex stuff
                    tid = tid[2:]
            if d[0] == "user_data":
                    userData = d[1]
                    userData = userData.strip(',')
            if d[0] == "tid_authentic":
                tidAuthentic = d[1]
