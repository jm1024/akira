        id = str(uuid.uuid4())
        for thisAntenna in antennas:
            if str(thisAntenna.get('number')) == str(antenna):
                lane = thisAntenna.get('lane')
                side = thisAntenna.get('side')
        report['id'] = id
        report['lane'] = lane
        report['side'] = side
        
        # if squelched don't add
        if isSquelched(report['tid'], report['side']):
            if DEBUG_SQUELCH:
                print(f" is squelched {report['tid']} {report['side']}")
        else:
            #add to appropriate list
            #print(f"addReport {report['tid']} - {report['epc']}")
            reports.append(report)    
        
    ##################################################################
    #depart events
    if vals[0] == "event.tag.depart": # or vals[0] == "event.tag.arrive":
        
        if DEBUG_DEPART:
            print("+++++++++++++++++++++++++")
            print(event)
            print("-------------------------")
        
        date = ""
        last = ""
        antenna = ""
        rssi = ""
        reads = ""
        epc = ""
        tid = ""
        userData = ""
        tidAuthentic = ""
        pwAuthentic = ""

        reader = readerName

        for val in vals:
            d = val.split('=')
            if d[0] == "first":
                date = d[1].strip(',')
            if d[0] == "last":
                date = d[1].strip(',')
            if d[0] == "antenna":
                antenna = d[1].strip(',')
            #if d[0] == "rssi":
            #    rssi = d[1]
            if d[0] == "rssi":
                rssi = d[1]
                rssi = rssi.strip(',')
            if d[0] == "repeat":
                reads = d[1]
                reads = reads.strip(',')
