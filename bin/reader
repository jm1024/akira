#############################
def monitorNotifications(tn, stop_event):
    
    global lane
    
    print("Monitoring GPIO " + str(lane))
    print("--------------------")
    
    try:
        while not stop_event.is_set():
            data = tn.read_until(b"\n", timeout=1)
    
            if stop_event.is_set():
                break
    
            if not data:
                continue
    
            text = data.decode(errors="ignore").strip()
            if not text:
                continue
    
            state = parseGpio(text)
            if state is None:
                continue
    
            tripState, mainState, rearState = getMassStates(state)
    
            massEvent = {
                "date": datetime.now(),
                "trip": tripState,
                "main": mainState,
                "rear": rearState,
            }
    
            massQ.put(massEvent)
    
    except Exception as ex:
        print("Exception in mass monitorNotifications:", ex)
        traceback.print_exc()
    
    finally:
        print("MASS: closing telnet connection")
        try:
            tn.close()
        except Exception:
            pass
            
#############################
def readUntil(tn, marker, timeout=.5):
    """Read until marker bytes are seen or timeout expires."""
    if DEBUG:
        print(f"readUntil({marker!r})")
    data = tn.read_until(marker.encode("ascii"), timeout)
    if DEBUG and data:
        try:
            print("<<", data.decode(errors="ignore"))
        except Exception:
            print("<<", data)
    return data


#############################
def sendLine(tn, line):
    """Send a line terminated with CRLF."""
    msg = (line + "\r\n").encode("ascii")
    if DEBUG:
        print(">>", msg)
    tn.write(msg)


#############################
def login(tn):
    # Wait for "User Name:" prompt
    readUntil(tn, "User Name:", timeout=5)

    # Send username
    sendLine(tn, MASS_USERNAME)

    # Wait for "Password:" prompt
    readUntil(tn, "Password:", timeout=5)

    # Send password
    sendLine(tn, MASS_PASSWORD)

    # Read a little bit of what comes next
    time.sleep(0.2)
    data = tn.read_very_eager()
    text = data.decode(errors="ignore") if data else ""

    if DEBUG and text:
        print("LOGIN RESPONSE RAW:\n", text)

    if "Access denied" in text:
        print("LOGIN FAILED (Access denied)")
        raise SystemExit(1)

    # If no explicit error, treat as success
    print("Logged in OK")


#############################
def setAllInputsAndNotify(tn):
    """
    - iomask: affect all 16 bits
    - iodir: 1 = input, so ffff = all inputs
    - readall once (and set initial global state)
    - enable notifications
    """
    global state

    # iomask: affect all 16 bits
    sendLine(tn, "gpio iomask ffff")
    time.sleep(0.1)
    tn.read_very_eager()

    # iodir: 1 = input, so ffff = all inputs
    sendLine(tn, "gpio iodir ffff")
    time.sleep(0.1)
    tn.read_very_eager()

    # initial read
    sendLine(tn, "gpio readall")
    time.sleep(0.1)
    resp = tn.read_very_eager()

    if resp:
        text = resp.decode(errors="ignore").strip()
        if DEBUG:
            print("READALL:\n", text)

        parsed = parseGpio(text)
        if parsed is not None:
            state = parsed
            #updateMass(parsed)
            if DEBUG:
                print(state)

    # enable notifications
    sendLine(tn, "gpio notify on")
    time.sleep(0.1)
    tn.read_very_eager()

#############################
def parseGpio(text):
    
    #print("parseGpio: " + str(text))
    
    text = text.strip()
    if not text:
        return None

    #if DEBUG:
    #    print(text)

    parts = text.split()
    if not parts:
        return None

    hexChars = "0123456789ABCDEFabcdef"
    hexVal = None

    # Case 1: notification line like '# FEFF FEFE FFFF'
    # You believe the first hex after '#' is the current state,
    # so use parts[1].
    if parts[0] == "#" and len(parts) >= 2:
        candidate = "".join(c for c in parts[1] if c in hexChars)
        if candidate:
            hexVal = candidate

    # Case 2: readall or anything else: first token that has any hex in it
    if hexVal is None:
        for p in parts:
            candidate = "".join(c for c in p if c in hexChars)
            if candidate:
                hexVal = candidate
                break

    if hexVal is None:
        print("parseGpio: no hex found in:", repr(text))
        return None

    try:
        value = int(hexVal, 16)
    except ValueError:
        print("parseGpio: bad hex:", hexVal)
        return None

    # 16-bit, LSB = io100
    bits = f"{value:016b}"[::-1]

    result = {}
    for i in range(16):
        pin = i + 100
        result[f"{pin}"] = int(bits[i])

    #updateMass(result)

    return result
        
#############################
def updateMass_DEPRECATED(current):
    
    global massName
    global locked
    global lastLock
    global lastLockState
    global lastBegin
    global lastEnd
    global lastTripState
    global lastMassState
    
    tripState = -1
    massState = -1

    current["date"] = datetime.now()
    tripState, massState = getMassStates(current)
    lastLockState = sidraCore.massLock(massName)
    
    
    #if DEBUG_STATE:
    #    print(str(current['date']) + " trip: " + str(tripState) + "  mass: " + str(massState))
        
    newLock = {}
    newLock['locked'] = "ERR"
    newLock['begin'] = ""
    newLock['end'] = ""
    newLock['count'] = lastLockState['count']
    
    
    if tripState == 1 and lastTripState == 0:
        newLock['count'] = lastLockState['count'] + 1
        
    lastTripState = tripState
    lastMassState = massState
    
    unlockLockout = False
    updateLock = False
    if not locked:
        #not locked, should it be?
        if tripState == 1 or massState == 1:
            locked = True
            lastLock = datetime.now()
            updateLock = True
    else:
        if tripState == 0 and massState == 0:
            #check for lockout
            
            unlockAt = lastLock + timedelta(seconds=UNLOCK_LOCKOUT)
            #print("cur: " + str(current['date']) + " ua: " + str(unlockAt))
            if current['date'] < unlockAt:
                unlockLockout = True
                print("LOCKED too recently - not unlocking")
            else:
                locked = False
                updateLock = True
                newLock['count'] = 0

    #if the lane was locked recently dont update the unlock
    if not unlockLockout:
        newLock['locked'] = locked
        
        #if this was a lock Triped by trip set the window
        if locked == True and tripState == 1:
            updateLock = True
            #if mass state has been hit too preserve the last begin and end
            if massState == 1:
                newLock['begin'] = lastLockState['begin'] #lastBegin
                newLock['end'] = lastLockState['end'] #lastEnd
            else:
                newLock['begin'] = current['date'] + timedelta(seconds=WINDOW_FAST_PRE)
                newLock['end'] = current['date'] + timedelta(seconds=WINDOW_FAST_POST)
                lastBegin = newLock['begin']
                lastEnd = newLock['end']
                
        #see if the lane is already locked by something else - dont set window
        fileMass = sidraCore.massLock(massName)
        if  fileMass['locked']:
            print("override lock set") 
            newLock['end'] = ""
            newLock['begin'] = ""
            #updateLock = False

    if updateLock:
        sidraCore.massLockSet(massName, newLock)
        debugMsg = "updateMass " + str(datetime.now()) + " c: " + str(newLock['count']) + " t: " + str(tripState) + " m: " + str(massState) + " locked: " + str(newLock['locked']) 
        debugMsg = "updateMass " + " c: " + str(newLock['count']) + " t: " + str(tripState) + " m: " + str(massState) + " locked: " + str(newLock['locked']) 
                
        if not newLock['end'] == "" and locked == True:
            debugMsg = debugMsg + " window:" + str(newLock['end'])
        print(debugMsg)
        
    #put in the queue for laneThread
    massQ.put(current)
    
    #update mass file
    output = json.dumps(current, default=sidraCore.jsonConverter)
    fileName = sidraCore.MASS_DIR + "/" + massName + sidraCore.STATE_EXTENSION_MASS 
    sidraCore.writeFile(fileName, output)

#############################
def massRules_DEPRECATED(tripState, mainState, stateTime, lastTripState, lastMainState, lastTime, previousTripState, previousMainState, previousTime):

    delay = 0
    
    #give the read time to finish
    if tripState == 1 and mainState == 0:
        print("sleeping fast " + str(DELAY_FAST))
        time.sleep(DELAY_FAST)
        
    if tripState == 1 and lastTripState == 0 and previousTripState == 1:
        diffMs = int((previousTime - stateTime).total_seconds() * 1000)
        print("tailgate threshold: " + str(diffMs))
    
    return delay

#############################
def getMassStates(current):
    
    global massPinTrip
    global massPinMain
    global massPinRear
    
    #print(current)
    trip = current[massPinTrip]
    main = current[massPinMain]
    rear = current[massPinRear]
    
    return trip, main, rear


