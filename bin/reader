#######################
def transaction(date, reader, lane, side, antenna, rssi, reads, epc, tid, userData, tidAuthentic, pwAuthentic):

    # get plate and class from userData
    tagPlate, tagClass = sidraCore.decodeUserData(userData)

    trnId = str(uuid.uuid4())

    trn = sidraCore.trnPrefix() + trnId
    #tDate = str(date) #datetime.now()
    #print(" ------>DT " + str(dt))
    #print("RSSI trans: " + str(rssi))

    #if DEBUG_TIMING:
    #   print("tDate: " + str(tDate))

    tData = {
        'id': trnId,
        'date': str(date),
        'reader': reader,
        'lane': lane,
        'side': side,
        'antenna': antenna,
        'ip': readerIp,
        'ts': date,
        'rssi': rssi,
        'reads': reads,
        'tid': tid,
        'epc': epc,
        'userData': userData,
        'tagPlate': tagPlate,
        'tagClass': tagClass,
        "tidAuthentic": tidAuthentic,
        "pwAuthentic": pwAuthentic,
    }

    #print("RD: " + str(readDrivers))
    #for driver in readDrivers:
    #    print("DRIVER: " + driver)
    #    driver.read(tData)
    #driverRts.read(tData)

    #tDate = sidraCore.rfStrToDt(tDate)
    #sAuth = "n"
    #if pwAuthentic == "AUTHENTIC":
    #    sAuth = "y"

    if DEBUG_FINAL:
        output = "==============================================="
        output = output + "\n" + str(date)
        output = output + "\n lane: " + str(lane)
        output = output + " ant: " + str(antenna)
        output = output + " epc: " + str(epc)
        output = output + "\n tid: " + str(tid)
        output = output + " user: "+  str(userData)
        output = output + "\n auth: " + str(pwAuthentic)
        output = output + " rssi: "+  str(rssi)
        output = output + " reads: "+  str(reads)
        output = output + "\n--------------------------------------------"
        print(output)

    #drivers
    #for driverName, driverModule in readDrivers.items():
    #    if DEBUG_DRIVER:
    #        print("running driver: " + str(driverName))
    #    if hasattr(driverModule, "read"):
    #        driverModule.read(tData)

    sidraCore.saveTransaction(trn + sidraCore.TRN_EXTENSION_READER, json.dumps(tData, default=sidraCore.jsonConverter))

    output = str(date)
    output = output + " RF  > lane: " + str(lane)
    output = output + " ant: " + str(antenna)
    output = output + " epc: " + str(epc)
    output = output + " tid: " + str(tid)
    output = output + " user: "+  str(userData)
    output = output + " auth: " + str(pwAuthentic)
    output = output + " rssi: "+  str(rssi)
    output = output + " reads: "+  str(reads)
    #output = output + " tagP: " + str(tagPlate)
    #output = output + " date: " + str(dt)

    sidraCore.log(output)

##################################################
# threads
##################################################

#######################
def rfThread(stop_event):

    while not stop_event.is_set():
        event = recvEvent()
        rfQ.put(event)

#######################
def massThread(stop_event):

    global lane
    global massName
    global massPinTrip
    global massPinMain
    global massPinRear
    global massIp
    global tnConn
    #print("massThread init: " + str(lane))

    for mass in sidraCore.massSensors:
        if mass["lane"] == lane:
            massName = mass["name"]
            #lane = mass["lane"]
            massIp = mass["ip"]
            massPinTrip = mass['trip']
            massPinMain = mass['main']
            massPinRear = mass['rear']

    print("MASS THREAD START " + str(lane))

    if DEBUG_MASS:
        print(f"Connecting to Numato GPIO @ {massIp}:{MASS_PORT}")

    tnConn = None

    try:
        tnConn = telnetlib.Telnet(massIp, MASS_PORT, timeout=5)

        # explicitly own both SIGINT (^C) and SIGHUP
        #signal.signal(signal.SIGINT, handleSignal)
        #signal.signal(signal.SIGHUP, handleSignal)

        login(tnConn)
        setAllInputsAndNotify(tnConn)
        monitorNotifications(tnConn, stop_event)

    except Exception as ex:
        print("massThread(): " + str(ex))


    #while not stop_event.is_set():
    #    event = massEvent()
    #    massQ.put(event)

#######################
def laneThread(stop_event):

    print("LANE THREAD START " + str(lane) + '\n')

    massTrip = 0
    massMain = 0
    massDate = datetime.now()

    #lastMassTrip = -1
    #lastMassMain = -1
    #lastMassRear = -1
    #lastMassDate = datetime.now()

    lastMass = {"trip":-1,"tripLast":datetime.now(),"main":-1,"mainLast":datetime.now(),"rear":-1,"rearLast":datetime.now(),"lastUnlocked":datetime.now(), "updated":datetime.now(), "unlockLockout":False}

    #was the last fast read good
    lastFastGood = False
    lastFastTid = "NONE"
    lastFastValid = False
    lastLastFastValid = False

    lastFc = -1
    lastSc = -1
    lastSquelchCount = -1

    fastWindow = resetWindow("fast - initial") #{'locked':False,'reading':False,'begin':datetime.now(),'end':datetime.now(),'updated':datetime.now()}
    slowWindow = resetWindow("slow - initial") #{'locked':False,'reading':False,'begin':datetime.now(),'end':datetime.now(),'updated':datetime.now()}
    #print(fastWindow)
    #print(slowWindow)

    massUpdated = False

    while not stop_event.is_set():
        updates = False
        rfUpdated = False
        massUpdated = False

        #receive rf updates
        rfCount = 0
        while True:
            try:
                event = rfQ.get_nowait()
                if event is STOP:
                    stop_event.set()
                    return
                #print("rf event:")
                rfCount = rfCount +1
            except queue.Empty:
                break

            parseEvent(event)
            #print("laneThread received:")
            rfUpdated = True
            updates = True
            rfQ.task_done()

        #if rfCount > 0:
        #    print("rfCount: " + str(rfCount))

        #receive mass updates
        while True:
            try:
                massEvent = massQ.get_nowait()
                if massEvent is STOP:
                    stop_event.set()
                    return
                #print("massEvent: " + str(massEvent))
            except queue.Empty:
                break

            massUpdated = True
            updates = True
            massQ.task_done()

        # if no updates yield CPU
        if not updates:
            time.sleep(0.002)

        #read responses from any enabled drivers
        responses = []
        for driverName, driverModule in readDrivers.items():
            #print("XXX running driver: " + str(driverName))
            if DEBUG_DRIVER:
                print("running driver: " + str(driverName))
            if hasattr(driverModule, "getResponses"):
                responses = driverModule.getResponses()

        #check responses for validation of last fast tag
        if len(responses) > 0:
            for response in responses:
                if DEBUG_DRIVER_RESPONSES:
                    print(response)
                if response['type'] == "tagResult":
                    if lastFastGood:
                        if response['tid'] == lastFastTid and response['valid']:
                            lastLastFastValid = lastFastValid
                            lastFastValid = True
                            if DEBUG_DRIVER_RESPONSES:
                                print(f"VALIDATED {response['tid']}")

        # if mass has changed state - set windows
        if massUpdated:
            massTrip = int(massEvent.get("trip",-1))
            massMain = int(massEvent.get("main",-1))
            massRear = int(massEvent.get("rear",-1)) # massEvent.get("rear",-1) <- JM CHANGE WHEN REAR IS ENABLED
            massDate = datetime.now()

            #################
            #all sensors clear
            if massMain == 0 and massTrip == 0 and massRear == 0:
                if datetime.now() > lastMass['tripLast'] + timedelta(milliseconds=UNLOCK_LOCKOUT) and datetime.now() > lastMass['mainLast'] + timedelta(milliseconds=UNLOCK_LOCKOUT):
                    fastWindow = resetWindow(f"fast - lane clear {massTrip}{massMain}{massRear}")
                    slowWindow = resetWindow(f"slow - lane clear {massTrip}{massMain}{massRear}")
                    lastMass["lastUnlocked"] = datetime.now()
                    #laneClear messages
                    for driverName, driverModule in readDrivers.items():
                        if DEBUG_DRIVER:
                            print("running driver: " + str(driverName))
                        if hasattr(driverModule, "laneClear"):
                            driverModule.laneClear(lane)
                else:
                    lastMass['unlockLockout'] = True
                    print(f"unlock lockout {massTrip} {massMain} {massRear}")

            #################
            #if theres a change in trip
            if massTrip == 1 and not massTrip == lastMass['trip']:

                #print(f"LFG: {lastFastTid} {lastFastGood} {lastFastValid}")

                #check for Fast Flow - if previous fast was good
                if lastFastGood and lastFastValid:
                    begin = massDate + timedelta(milliseconds=fastPre)
                    end   = massDate + timedelta(milliseconds=fastPost)
                    print(f" -= FAST FLOW ON =-")
                    fastWindow = readWindow(fastWindow, begin, end, f"fast - trip sensor {massTrip}{massMain}{massRear}")
                    lastFastGood = False
                    lastFastTid = "NONE"
                    lastFastValid = False
                elif massMain == 0 and massRear == 0:
                #if slow and rear are clear
                    print(f" READING - NO FAST FLOW -lfv:{lastFastValid} llfv:{lastLastFastValid}")
                    begin = massDate + timedelta(milliseconds=fastPre)
                    end   = massDate + timedelta(milliseconds=fastPost)
                    fastWindow = readWindow(fastWindow, begin, end, f"fast - trip sensor {massTrip}{massMain}{massRear}")
                else:
                    print(f" NOT READING FAST {massTrip}{massTrip}{massRear}")

            #################
            #if theres a change in main
            #if massMain == 1 and lastMass['main'] == 0:
                #print("LOCK SLOW")
            #    slowWindow = lockWindow(f"slow - main sensor {massTrip}{massMain}{massRear}")

            #################
            #if theres a change in rear
            if massRear == 1 and lastMass['rear'] == 0:
                begin = massDate + timedelta(milliseconds=slowPre)
                end   = massDate + timedelta(milliseconds=slowPost)
                #fastWindow = lockWindow("fast - main sensor") # <--- JM do we want this?
                slowWindow = readWindow(slowWindow, begin, end, f"slow - rear sensor {massTrip}{massMain}{massRear}")


            # save current state as last state
            lastMass["trip"] = massTrip
            lastMass["main"] = massMain
            lastMass["rear"] = massRear
            lastMass["updated"] = massDate
            lastMass["unlockLockout"] = False
            if not lastMass['trip'] == massTrip:
                lastMass['tripLast'] = datetime.now()
            if not lastMass['main'] == massMain:
                lastMass['mainLast'] = datetime.now()
            if not lastMass['rear'] == massRear:
                lastMass['rearLast'] = datetime.now()


            if DEBUG_MASS:
                debugMass(massTrip, massMain, massRear, fastWindow, slowWindow, lastMass)

        #################
        #check fast zone
        read = checkReads(fastWindow, ANTENNA_FAST, fastMinReads)
        if not read == None:

            #re-open fast antenna
            fastWindow = resetWindow(f"fast - read accepted  {massTrip}{massMain}{massRear}")
            lastFastGood = True
            lastFastTid = read['tid']
            lastFastValid = False

            sendRead(read)

            #squelch
            addSquelch(read['tid'], read['side'], SQUELCH_TIME)

            #flushReports(ANTENNA_FAST)
            if LOG_STATS:
                sidraCore.appendFile(LOG_STATS_FILE,f"fast: {read['tid']} {datetime.now().time()}\n")

            #make a fake tag response - only for debugging
            if GEN_FAKE_TAG_RESPONSE:
                for driverName, driverModule in readDrivers.items():
                    if DEBUG_DRIVER:
                        print("running driver: " + str(driverName))
                    if hasattr(driverModule, "genFakeTagResponse"):
                        responses = driverModule.genFakeTagResponse(read['tid'])

        #################
        #check slow zone
        read = checkReads(slowWindow, ANTENNA_SLOW, slowMinReads)
        if not read == None:

            #reset read window until lane clear
            thisDate = datetime.now()
            begin = thisDate + timedelta(milliseconds=slowPre)
            end   = thisDate + timedelta(milliseconds=slowPost)
            #fastWindow = lockWindow("fast - main sensor") # <--- JM do we want this?
            #slowWindow = readWindow(slowWindow, begin, end, "slow - main sensor") # JM MAYBE we want tis istead of reset???
            slowWindow = resetWindow(f"slow - read accepted {massTrip}{massMain}{massRear}")
            sendRead(read)

            #squelch
            addSquelch(read['tid'], read['side'], SQUELCH_TIME)

            #flushReports(ANTENNA_SLOW)
            if LOG_STATS:
                sidraCore.appendFile(LOG_STATS_FILE,f"slow: {read['tid']} {datetime.now().time()}\n")

        #################
        #check for expired windows
        fastExpired = windowExpired(fastWindow)
        slowExpired = windowExpired(slowWindow)
        if fastExpired:
            print(f"fastExpired used: {fastWindow['used']} - end: {fastWindow['end'].time()} {datetime.now().time()}")
            fastWindow = resetWindow("fast - expired")
            #noTag messages
            for driverName, driverModule in readDrivers.items():
                if DEBUG_DRIVER:
                    print("running driver: " + str(driverName))
                if hasattr(driverModule, "noTag"):
                    driverModule.noTag(lane)
        if fastExpired:
            print(f"slowExpired used: {slowWindow['used']} - end: {slowWindow['end'].time()} {datetime.now().time()}")
            slowWindow = resetWindow("slow - expired")
            #noTag messages
            for driverName, driverModule in readDrivers.items():
                if DEBUG_DRIVER:
                    print("running driver: " + str(driverName))
                if hasattr(driverModule, "noTag"):
                    driverModule.noTag(lane)

        #clean old RF events
        cleanOldRf(ANTENNA_FAST, fastMaxReportAge)
        cleanOldRf(ANTENNA_SLOW, slowMaxReportAge)
        #print(slowMaxReportAge)

        #clean squelch list
        if DEBUG_SQUELCH:
            squelchCount = len(squelch)
            if not squelchCount == lastSquelchCount:
                print(f"squelchCount: {squelchCount}")
            lastSquelchCount = squelchCount
        cleanSquelch()

        #see if you need to break lockout
        lockoutChanged, fastWindow, slowWindow = lockoutBreak(fastWindow, slowWindow, lastMass)
        if lockoutChanged:
            debugMass(massTrip, massMain, massRear, fastWindow, slowWindow, lastMass)

        #debug read stats
        if DEBUG_READ_MONITOR or LOG_STATS:
            fc, sc = countReports()
            fcs = str(fc).rjust(4)
            scs = str(sc).rjust(4)

            if DEBUG_READ_MONITOR:
                print(f"{fcs}{scs} {datetime.now().time()}")

            if LOG_STATS:
                if not lastSc == sc or not lastFc == fc :
                    if fcs == "   0":
                        fcs = "   -"
                    if scs == "   0":
                        scs = "   -"
                    sidraCore.appendFile(LOG_STATS_FILE,f"{fcs}{scs}  {datetime.now().time()}\n")
            lastFc = fc
            lastSc = sc

#######################
def checkReads(window, side, minReads):

    ret = None

    #if no reads don't waste time
    if len(reports) == 0:
        return ret

    #print("check " + str(side) + " " + str(len(reports)))

    candidateCount = 0
    candidates = {}

    #print("CR")

    totalCount = 0
    goodCount = 0
    badCount = 0
    badCountPre = 0
    badCountPost = 0
    badCountSide = 0
    blankTidCount = 0

    #if not window['reading']:
    #    print("-")
    #else:
    #    print(len(reports))
        #print("-")
    #if window['reading']:
    #    fc, sc = countReports()
    #    print(f"{fc} - {sc}")

    if window['reading']:
        #print(len(reports))
        for read in reports:
            totalCount = totalCount +1
            #print(f"{read['date']} b:{fast['begin']} e:{fast['end']}")
            if read['date'] > window['begin'] and read['date'] < window['end'] and read['side'] == side:
                goodCount = goodCount +1
                #print(f"cand:{read['tid']}")
                tid = read.get("tid", "")
                if not tid:
                    #print(f"checkReads() blank tid {datetime.now()}")
                    blankTidCount = blankTidCount + 1
                    continue  # ignore blank tids

                rssi = int(read.get("rssi", "-999999"))  # rssi comes in as string like "-538"

                if tid not in candidates:
                    # first time we see this tid in this window
                    candidates[tid] = {
                        "tid": tid,
                        "rssi": rssi,     # highest rssi so far
                        "count": 1,       # times seen
                        "firstSeen": read.get("date"),
                        "lastSeen": read.get("date"),
                        "date": read.get("date"),
                        "reader": readerName,                 # report dict doesn't have reader
                        "lane": read.get("lane"),
                        "side": read.get("side"),
                        "antenna": read.get("antenna"),
                        "rssi": rssi,                         # keep as int or str, your call
                        "reads": 1,                           # will track count
                        "epc": read.get("epc"),
                        "tid": tid,
                        "userData": read.get("userData"),
                        "tidAuthentic": read.get("tidAuthentic"),
                        "pwAuthentic": read.get("pwAuthentic"),
                    }
                else:
                    update = candidates[tid]
                    update["count"] += 1
                    update["lastSeen"] = read.get("date")

                    # update best rssi (less negative = higher)
                    if rssi > update["rssi"]:
                        update["rssi"] = rssi
                        update["bestRead"] = read
                    if not read.get("userData","") == "":
                        update['userData'] = read.get('userdata')
                    if read.get('pwAuthentic','') == AUTH_AUTHENTIC:
                        update['pwAuthentic'] = AUTH_AUTHENTIC
                    if read.get('tidAuthentic','') == AUTH_AUTHENTIC:
                        update['tidAuthentic'] = AUTH_AUTHENTIC
            else:
                if read['date'] < window['begin']:
                    badCountPre = badCountPre +1
                if  read['date'] > window['end']:
                    badCountPost = badCountPost +1
                if not read['side'] == side:
                    badCountSide = badCountSide +1
                badCount = badCount +1
                #print(f"read not in scope {read['antenna']} t:{read['date']}")

        #if blankTidCount > 0:
        #    print(f"blank Tid count:{blankTidCount}")

        # find best candidate
        candidateCount = 0
        highestCount = 0
        potential = None
        accepted = None

        #if this is a mixed pool
        if len(candidates) > 1:
            print("******************************")
            print("mixed read pool:")
            for tid in candidates:
                poolCount = candidates[tid]["count"]   # or len(...) if you want fields
                print(f"{tid} {poolCount}")
            print("******************************")

        #check candidates to see if any are > minReads and if they are authentic
        highestCandidate = ""
        for candidate in candidates.values():
            #print(f"{side} t:{candidate.get('tid')} c:{candidate.get('count')} t:{totalCount} g:{goodCount} b:{badCount} bPre:{badCountPre} bPost:{badCountPost} bSide:{badCountSide} - {datetime.now()}")
            candidateCount = candidateCount +1
            thisCount = candidate.get('count')
            if thisCount > highestCount:
                #if not candidate.get('tidAuthentic','') == AUTH_AUTHENTIC: # <--- JM to enable auth
                #    if DEBUG_INAUTHENTIC:
                #        print("INAUTHENTIC TAG: " + candidate.get('tid','none'))
                #else:
                # - for now include inauthentic tags
                highestCount = thisCount
                potential = candidate

        #if you have a potential does it have enough reads?
        if not potential == None:
            if potential['count'] >= minReads:
                accepted = potential

        #if you've accepted a candidate
        if not accepted == None:
            accepted['id'] = str(uuid.uuid4())
            if MULTI_POOL_SQUELCH:
                if len(candidates) > 1:
                    for tid in candidates:
                        if not tid == accepted['tid']:
                            print("#############################################")
                            print(f"Multi Pool Squelch - {tid}")
                            print("#############################################")
                            sidraCore.log(f"Multi Pool Squelch -> {tid} kept: {accepted['tid']}")
                            addSquelch(tid, ANTENNA_FAST, SQUELCH_TIME)
                            addSquelch(tid, ANTENNA_SLOW, SQUELCH_TIME)
            if DEBUG:
                out = f"<<< {side}: {accepted['tid']} count: {accepted['count']} {accepted['tidAuthentic']}"
                if LOG_EVENTS:
                    sidraCore.appendFile(LOG_EVENTS_FILE,out + '\n')
                print(out)
            ret = accepted

            window['used'] = True

    if DEBUG_READ_SEEK:
        if ret == None and candidateCount > 0:
            print("CR: ",f"{side} {candidateCount} {highestCount}", end="\r", flush=True)
            #print(f"cr {side} {candidateCount} {highestCount}")

    #if not ret == None:
    #    print('\n')

    # return
    return ret

#######################
def sendRead(read):

    #drivers and transaction
    for driverName, driverModule in readDrivers.items():
        if DEBUG_DRIVER:
            print("running driver: " + str(driverName))
        if hasattr(driverModule, "read"):
            driverModule.read(read)

    #trans
    transaction(read['date'], read['reader'], read['lane'], read['side'], read['antenna'], read['rssi'], read['reads'], read['epc'], read['tid'], read['userData'], read['tidAuthentic'], read['pwAuthentic'])


#######################
def removeReports(tid, side):
    global reports
    reports[:] = [
        r for r in reports
        if not (r.get("tid") == tid and r.get("side") == side)
    ]

#######################
def addSquelch(tid, side, duration):

    global squelch

    if not isSquelched(tid, side):

        end = datetime.now() + timedelta(milliseconds=duration)

        newSquelch = {'tid':tid, 'side':side, 'end':end}

        squelch.append(newSquelch)

        #clean reports of this tag on this side
        removeReports(tid, side)

        if LOG_STATS and DEBUG_SQUELCH:
            sidraCore.appendFile(LOG_STATS_FILE,f"squelch: {tid}\n")

        if DEBUG_SQUELCH:
            print(f"squelched: {tid} {side} {end} {datetime.now()}")


#######################
def cleanSquelch():
    global squelch

    now = datetime.now()

    squelch[:] = [
        s for s in squelch
        if s.get("end") >= now
    ]

#######################
def isSquelched(tid, side):

    #now = datetime.now()
    for s in squelch:
        if (
            s.get("tid") == tid and
            s.get("side") == side #and
            #s.get("end", now) > now
        ):
            return True
    return False

#######################
def flushReports(side):

    global reports
    #start = len(reports)
    reports[:] = [r for r in reports if r.get("side") != side]
    #end = len(reports)

    #print(f"flushReports: {start} -> {end}")

#######################
def windowExpired(window):

    ret = False

    if window['reading']:
        if datetime.now() > window['end']:
            ret = True

    return ret

#######################
def readWindow(window, begin, end, name = ""):

    if DEBUG_WINDOW:
        print(f"window read: {name} {datetime.now()}")
    window['locked'] = True
    window['reading'] = True
    window['begin'] = begin
    window['end'] = end
    window['used'] = False
    window['usedBy'] = ""
    window['updated'] = datetime.now()

    return window

#######################
def lockWindow(name = ""):

    if DEBUG_WINDOW:
        print(f"window lock: {name} {datetime.now()}")
    window = {}
    window['locked'] = True
    window['reading'] = False
    window['begin'] = datetime.now()
    window['end'] = datetime.now()
    window['used'] = False
    window['usedBy'] = ""
    window['updated'] = datetime.now()

    return window

#######################
def resetWindow(name = ""):

    if DEBUG_WINDOW:
        print(f"window reset: {name} {datetime.now()}")
    window = {}
    window['locked'] = False
    window['reading'] = False
    window['begin'] = datetime.now()
    window['end'] = datetime.now()
    window['used'] = False
    window['usedBy'] = ""
    window['updated'] = datetime.now()

    return window

#######################
def countReports():
    fc = 0
    sc = 0
    for r in reports:
        if r['side'] == ANTENNA_FAST:
            fc = fc +1
        if r['side'] == ANTENNA_SLOW:
            sc = sc + 1

    return fc, sc

#######################
def debugMass(massTrip, massMain, massRear, fastWindow, slowWindow, lastMass):

    fc = 0
    sc = 0

    fastBegin = fastWindow['begin'].time()
    fastEnd = fastWindow['end'].time()
    fastUpdated = fastWindow['updated'].time()
    slowBegin = slowWindow['begin'].time()
    slowEnd = slowWindow['end'].time()
    slowUpdated = slowWindow['updated'].time()
    #print(f"FAST b:{fastBegin} e:{fastEnd} u:{fastUpdated} l:{fastWindow['locked']} r:{fastWindow['reading']}")
    #print(f"SLOW b:{slowBegin} e:{slowEnd} u:{slowUpdated} l:{slowWindow['locked']} r:{slowWindow['reading']}")

    out = str(massTrip) + " " + str(massMain) + " " + str(massRear) + " "
    if fastWindow['reading']:
        #print(f"{fastWindow['end']} {datetime.now()}")
        if fastWindow['end'] > datetime.now():
            out = out + "R"
        else:
            out = out + "x"
    else:
        out = out + "-"
    if fastWindow['locked']:
        out = out + "L"
    else:
        out = out + "-"
    out = out + " "
    if slowWindow['reading']:
        if slowWindow['end'] > datetime.now():
            out = out + "R"
        else:
            out = out + "x"
    else:
        out = out + "-"
    if slowWindow['locked']:
        out = out + "L"
    else:
        out = out + "-"

    fc, sc = countReports()
    out = out + " " + str(fc).rjust(3) + " " + str(sc).rjust(3) + " " + str(datetime.now().time())
    out = out + f" ({fastBegin}-{fastEnd} {slowBegin}-{slowEnd})"
    print(out)

    if LOG_STATS:
        sidraCore.appendFile(LOG_STATS_FILE,out + '\n')

    if LOG_EVENTS:
        sidraCore.appendFile(LOG_EVENTS_FILE,out + '\n')

    if massTrip == 0 and massMain == 0 and massRear == 0:
        print('')

#######################
def cleanOldRf(side, maxAge):

    global reports

    cutoff = datetime.now() - timedelta(milliseconds=maxAge)

    reports[:] = [
        r for r in reports
        if not (
            r.get("side") == side and
            isinstance(r.get("date"), datetime) and
            r["date"] < cutoff
        )
    ]

#######################
def lockoutBreak(fastWindow, slowWindow, lastMass):


    #global fastWindow
    #global slowWindow

    changed = False

    #print(f"{lastMass['trip']} {lastMass['main']}")
    if int(lastMass['trip']) == 0 and int(lastMass['main']) == 0 and int(lastMass['rear']) == 0 and lastMass['unlockLockout'] == True:

        unlockAt = lastMass['lastUnlocked'] + timedelta(milliseconds=UNLOCK_LOCKOUT)
        #print(f"{lastMass['lastUnlocked']} {unlockAt}")
        if datetime.now() > unlockAt:
            #print(fastWindow)
            #print(slowWindow)
            fastWindow = resetWindow("fast - lane clear")
            slowWindow = resetWindow("slow - lane clear")
            lastMass['unlockLockout'] = False
            lastMass["lastUnlocked"] = datetime.now()
            #print("lock break")
            changed = True

    return changed, fastWindow, slowWindow

############################################
# thread control

#######################
def startThreads():

    stop_event = threading.Event()

    tRecv = threading.Thread(target=rfThread, args=(stop_event,), name="rfThread", daemon=True)
    tMass = threading.Thread(target=massThread, args=(stop_event,), name="massThread", daemon=True)
    tLane = threading.Thread(target=laneThread, args=(stop_event,), name="laneThread", daemon=True)

    tRecv.start()
    tMass.start()
    tLane.start()

    return stop_event, (tRecv, tMass, tLane)

#######################
def stopThreads(stop_event, threads):

    stop_event.set()

    # unblock queues
    try:
        rfQ.put_nowait(STOP)
    except Exception:
        pass

    try:
        massQ.put_nowait(STOP)
    except Exception:
        pass

    for t in threads:
        t.join(timeout=2.0)

############################################################################################
# main

CONFIGURE = True

readerName = sys.argv[1]

sidraCore.log("Reader " + readerName + " Starting")

for reader in sidraCore.readers:
    #print(reader['name'])
    if reader['name'] == readerName:
        readerIp = reader['ip']
        tagFilter = reader.get("tagFilter","")
        antennas = reader['antennas']
        power = reader['power']
        frequency = reader['frequency']
        auth = reader.get("auth", True)
        authWait = reader.get("authWait", True)
        tidWait = reader.get("tidWait", True)
        mode = reader.get("mode", "C1G2_MODE_640_MILLER2")
        lane = reader.get("lane","")
        fastMaxReportAge = int(reader.get("fastMaxReportAge","5000"))
        fastMinReads = int(reader.get("fastMinReads","5"))
        slowMaxReportAge = int(reader.get("slowMaxReportAge","5000"))
        slowMinReads = int(reader.get("slowMinReads","5"))
        slowTrigger = reader.get("slowTrigger","main")
        fastPre = int(reader.get("fastPre","0"))
        fastPost = int(reader.get("fastPost","0"))
        slowPre = int(reader.get("slowPre","0"))
        slowPost = int(reader.get("slowPost","0"))

print(fastPre)
print(fastPost)
print(slowPre)
print(slowPost)

if DEBUG:
        print("Reader " + readerName + " Starting")
        print("IP: " + str(readerIp))
        print("Lane: " + str(lane))

#init command connection
command_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
command_socket.connect((readerIp, READER_COMMAND_PORT))

# init event connection
event_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
event_socket.connect((readerIp, READER_EVENT_PORT))


#login
ret = xrCmd("reader.login(admin, admin)")

if CONFIGURE:
    #setup
    ret = xrCmd("reader.login(admin, admin)")
    ret = xrCmd("setup.operating_mode=standby")
    #ret = xrCmd("version.detail")
