#############################
def monitorNotifications(tn, stop_event):
    
    global lane
    
    try:
        while not stop_event.is_set():
            data = tn.read_until(b"\n", timeout=1)
    
            if stop_event.is_set():
                break
    
            if not data:
                continue
    
            text = data.decode(errors="ignore").strip()
            if not text:
                continue
    
            state = parseGpio(text)
            if state is None:
                continue
    
            tripState, mainState, rearState = getMassStates(state)
    
            massEvent = {
                "date": datetime.now(),
                "trip": tripState,
                "main": mainState,
                "rear": rearState,
            }
    
            #massQ.put(massEvent)
            try:
                massQ.put(massEvent, timeout=0.05)
            except queue.Full:
                print("massQ FULL - laneThread not draining?")
    
    except Exception as ex:
        print("Exception in mass monitorNotifications:", ex)
        traceback.print_exc()
    
    finally:
        print("MASS THREAD END " + str(lane))
        try:
            tn.close()
        except Exception:
            pass
            
#############################
def readUntil(tn, marker, timeout=.5):
    """Read until marker bytes are seen or timeout expires."""
    if DEBUG_MASS_DETAIL:
        print(f"readUntil({marker!r})")
    data = tn.read_until(marker.encode("ascii"), timeout)
    if DEBUG_MASS_DETAIL and data:
        try:
            print("<<", data.decode(errors="ignore"))
        except Exception:
            print("<<", data)
    return data


#############################
def sendLine(tn, line):
    """Send a line terminated with CRLF."""
    msg = (line + "\r\n").encode("ascii")
    if DEBUG_MASS_DETAIL:
        print(">>", msg)
    tn.write(msg)


#############################
def login(tn):
    # Wait for "User Name:" prompt
    readUntil(tn, "User Name:", timeout=5)

    # Send username
    sendLine(tn, MASS_USERNAME)

    # Wait for "Password:" prompt
    readUntil(tn, "Password:", timeout=5)

    # Send password
    sendLine(tn, MASS_PASSWORD)

    # Read a little bit of what comes next
    time.sleep(0.2)
    data = tn.read_very_eager()
    text = data.decode(errors="ignore") if data else ""

    #if DEBUG and text:
    #    print("LOGIN RESPONSE RAW:\n", text)

    if "Access denied" in text:
        print(" reader.mass LOGIN FAILED (Access denied)")
        raise SystemExit(1)

    # If no explicit error, treat as success
    #print("Logged in OK")


#############################
def setAllInputsAndNotify(tn):
    """
    - iomask: affect all 16 bits
    - iodir: 1 = input, so ffff = all inputs
    - readall once (and set initial global state)
    - enable notifications
    """
    global state

    # iomask: affect all 16 bits
    sendLine(tn, "gpio iomask ffff")
    time.sleep(0.1)
    tn.read_very_eager()

    # iodir: 1 = input, so ffff = all inputs
    sendLine(tn, "gpio iodir ffff")
    time.sleep(0.1)
    tn.read_very_eager()

    # initial read
    sendLine(tn, "gpio readall")
    time.sleep(0.1)
    resp = tn.read_very_eager()

    if resp:
        text = resp.decode(errors="ignore").strip()
        if DEBUG_MASS_DETAIL:
            print("READALL:\n", text)

        parsed = parseGpio(text)
        if parsed is not None:
            state = parsed
            #updateMass(parsed)
            if DEBUG_MASS_DETAIL:
                print(state)

    # enable notifications
    sendLine(tn, "gpio notify on")
    time.sleep(0.1)
    tn.read_very_eager()

#############################
def parseGpio(text):
    
    #print("parseGpio: " + str(text))
    
    text = text.strip()
    if not text:
        return None

    #if DEBUG:
    #    print(text)

    parts = text.split()
    if not parts:
        return None

    hexChars = "0123456789ABCDEFabcdef"
    hexVal = None

    # Case 1: notification line like '# FEFF FEFE FFFF'
    # You believe the first hex after '#' is the current state,
    # so use parts[1].
    if parts[0] == "#" and len(parts) >= 2:
        candidate = "".join(c for c in parts[1] if c in hexChars)
        if candidate:
            hexVal = candidate

    # Case 2: readall or anything else: first token that has any hex in it
    if hexVal is None:
        for p in parts:
            candidate = "".join(c for c in p if c in hexChars)
            if candidate:
                hexVal = candidate
                break

    if hexVal is None:
        print("parseGpio: no hex found in:", repr(text))
        return None

    try:
        value = int(hexVal, 16)
    except ValueError:
        print("parseGpio: bad hex:", hexVal)
        return None

    # 16-bit, LSB = io100
    bits = f"{value:016b}"[::-1]

    result = {}
    for i in range(16):
        pin = i + 100
        result[f"{pin}"] = int(bits[i])

    #updateMass(result)

    return result
        

#############################
def getMassStates(current):
    
    global massPinTrip
    global massPinMain
    global massPinRear
    
    #print(current)
    trip = current[massPinTrip]
    main = current[massPinMain]
    rear = current[massPinRear]
    
    return trip, main, rear


