#######################
def xmitCmd(cmd):

    if DEBUG_READER_COMM:
        print(readerIp + " -> " + cmd)

    cmd = cmd + "\r\n"
    command_socket.sendall(cmd.encode())

#######################
def recvCmd():

    bResp = command_socket.recv(256)

    if DEBUG_READER_COMM:
        print(readerIp + " <- " + bResp.decode().strip())

    return bResp.decode().strip()

#######################
def xrCmd(cmd):

    xmitCmd(cmd)
    return recvCmd()

#######################
def recvEvent():

    bResp = event_socket.recv(256)

    if DEBUG_READER_RECV:
        print(readerIp + " << " + bResp.decode().strip())

    return bResp.decode().strip()


