def getSwitchFile():
    ret = False
    try:
        result = akiraCore.readFile(akiraCore.TMP_DIR + "/" + READER_SWITCH_FILE)
        text = result.strip().lower()
        if text in ("1", "on", "true", "high"):
            ret = True
    except Exception as ex:
        print("reader.getSwitchFile() " + str(ex))

    return ret


def acquireReaderProcessLock(reader_name):
    """Hold a Linux abstract socket so only one process owns a reader."""
    global readerProcessLock

    safeName = re.sub(r"[^A-Za-z0-9_.-]", "_", str(reader_name))
    address = "\0akira.reader." + safeName
    lockSocket = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        lockSocket.bind(address)
    except OSError as ex:
        lockSocket.close()
        if ex.errno == errno.EADDRINUSE:
            raise RuntimeError(f"reader {reader_name} is already running") from ex
        raise
    readerProcessLock = lockSocket
    return lockSocket

