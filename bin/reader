#############################
def publishMassState(context, current):
    logicalState = massSensor.logicalState(current, context.mass_config)
    massEvent = {
        "lane": context.lane,
        "date": datetime.now(),
        **logicalState,
    }

    # One Numato monitor owns each lane. Changes within an occupied group do
    # not change passage state, but still belong in the raw diagnostic snapshot.
    state = tuple(logicalState[role] for role in massSensor.MASS_ROLES)
    published = False
    if state != context.lastPublishedMassState:
        try:
            context.massQ.put(massEvent, timeout=0.05)
        except queue.Full:
            print(f"massQ FULL - lane {context.lane} not draining?")
        else:
            context.lastPublishedMassState = state
            published = True

    if published and LOG_READS:
        akiraCore.appendFile(LOG_READS_FILE, json.dumps(massEvent, default=akiraCore.jsonConverter) + '\n')

    try:
        massFile = akiraCore.MASS_DIR + "/" + context.lane + akiraCore.STATE_EXTENSION_MASS
        akiraCore.writeFile(massFile, json.dumps(massEvent, default=akiraCore.jsonConverter))
    except Exception as ex:
        print(f"reader.publishMassState error writing mass file {context.lane} {str(ex)}")
    return published


#############################
def monitorNotifications(tn, stop_event, context):

    try:
        while not stop_event.is_set():
            data = tn.readline(timeout=1)

            if stop_event.is_set():
                break

            if not data:
                continue

            text = data.strip()
            if not text:
                continue

            state = parseGpio(text)
            if state is None:
                continue

            publishMassState(context, state)



    except Exception as ex:
        print(f"Exception in mass monitorNotifications lane:{context.lane}: {ex}")
        traceback.print_exc()

    finally:
        print("MASS THREAD END " + context.lane)
        try:
            sendLine(tn, "gpio notify off")
            tn.read_available(timeout=0.2)
        except Exception:
            pass
        try:
            tn.close()
        except Exception:
            pass

#############################
def readUntil(tn, marker, timeout=.5):
    """Read until a text marker is seen or timeout expires."""
    if DEBUG_MASS_DETAIL:
        print(f"readUntil({marker!r})")
    data = tn.read_until(marker, timeout=timeout)
    if DEBUG_MASS_DETAIL and data:
        print("<<", data)
    return data


#############################
def sendLine(tn, line):
    """Send a line terminated with CRLF."""
    if DEBUG_MASS_DETAIL:
        print(">>", line)
    tn.write_line(line)


#############################
def login(tn):
    # Wait for "User Name:" prompt
    readUntil(tn, "User Name:", timeout=5)

    # Send username
    sendLine(tn, MASS_USERNAME)

    # Wait for "Password:" prompt
    readUntil(tn, "Password:", timeout=5)

    # Send password
    sendLine(tn, MASS_PASSWORD)

    # Read a little bit of what comes next
    time.sleep(0.2)
    text = tn.read_available(timeout=0.2)

    #if DEBUG and text:
    #    print("LOGIN RESPONSE RAW:\n", text)

    if "Access denied" in text:
        print(" reader.mass LOGIN FAILED (Access denied)")
        raise SystemExit(1)

    # If no explicit error, treat as success
    #print("Logged in OK")


#############################
def setAllInputsAndNotify(tn, context):
    """
    - iomask: affect all 16 bits
    - iodir: 1 = input, so ffff = all inputs
    - readall once (and set initial global state)
    - enable notifications
    """
    # Each connection must publish an initial snapshot, even if it matches the
    # previous connection. If readall is empty, the first notification does so.
    context.lastPublishedMassState = None
    # iomask: affect all 16 bits
    sendLine(tn, "gpio iomask ffff")
    tn.read_available(timeout=0.2)

    # iodir: 1 = input, so ffff = all inputs
    sendLine(tn, "gpio iodir ffff")
    tn.read_available(timeout=0.2)

    # initial read
    sendLine(tn, "gpio readall")
    resp = tn.read_available(timeout=0.2)

    if resp:
        text = resp.strip()
        if DEBUG_MASS_DETAIL:
            print("READALL:\n", text)

        parsed = parseGpio(text)
        if parsed is not None:
            publishMassState(context, parsed)
            if DEBUG_MASS_DETAIL:
                print(parsed)

    # enable notifications
    sendLine(tn, "gpio notify on")
    tn.read_available(timeout=0.2)

#############################
def parseGpio(text):
    return massSensor.parseGpio(text)


#############################
def getMassStates(current, mass_config):
    logicalState = massSensor.logicalState(current, mass_config)
    return logicalState["fast"], logicalState["mid"], logicalState["slow"]


##################################################
# reader comm control
##################################################

#######################
def xmitCmd(cmd):

    if DEBUG_READER_COMM:
        print(readerIp + " -> " + cmd)

    if command_socket is None:
        raise ConnectionError("reader command connection is not open")
    cmd = cmd + "\r\n"
    command_socket.sendall(cmd.encode("ascii"))

#######################
def recvCmd():

    global commandRecvBuffer

    if command_socket is None:
        raise ConnectionError("reader command connection is not open")

    while True:
        marker = commandRecvBuffer.find(READER_FRAME_DELIMITER)
        if marker >= 0:
            bResp = commandRecvBuffer[:marker]
            commandRecvBuffer = commandRecvBuffer[marker + len(READER_FRAME_DELIMITER):]
            break
        if len(commandRecvBuffer) > READER_MAX_FRAME_BYTES:
            raise ConnectionError(
                f"reader command frame exceeded {READER_MAX_FRAME_BYTES} bytes without delimiter"
            )
        chunk = command_socket.recv(4096)
        if not chunk:
            raise ConnectionError("reader command connection closed")
        commandRecvBuffer += chunk

    if DEBUG_READER_COMM:
        print(readerIp + " <- " + bResp.decode("ascii", errors="replace").strip())

    return bResp.decode("ascii", errors="replace").strip()

#######################
def xrCmd(cmd):

    with commandLock:
        xmitCmd(cmd)
        response = recvCmd()
    firstLine = response.splitlines()[0].strip().lower() if response else ""
    if firstLine != "ok" and not firstLine.startswith("ok "):
        raise ReaderCommandError(f"reader rejected {cmd!r}: {response or 'empty response'}")
    return response

#######################
def connectCommandSocket():
    global command_socket
    global commandRecvBuffer

    with commandLock:
        oldSocket = command_socket
        command_socket = None
        commandRecvBuffer = b""
        if oldSocket is not None:
            try:
                oldSocket.close()
            except OSError:
                pass
        command_socket = socket.create_connection((readerIp, READER_COMMAND_PORT), timeout=5)
        command_socket.settimeout(5)


def closeCommandSocket():
    global command_socket
    global commandRecvBuffer

    with commandLock:
        oldSocket = command_socket
        command_socket = None
        commandRecvBuffer = b""
        if oldSocket is not None:
            try:
                oldSocket.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            oldSocket.close()


def readEventConnectionId(connection, stop_event=None, timeout=5):
    banner = connection.readFrame(stop_event=stop_event, timeout=timeout)
    if banner is None and stop_event is not None and stop_event.is_set():
        raise InterruptedError("reader event handshake interrupted")
    match = re.fullmatch(r"event\.connection\s+id\s*=\s*(\d+)", banner or "")
    if match is None:
        raise ConnectionError(f"invalid reader event banner: {banner!r}")
    return int(match.group(1))


def registerEventConnectionId(connectionId):
    for eventName in ("event.tag.arrive", "event.tag.report", "event.tag.depart"):
        xrCmd(f"reader.events.register({connectionId},{eventName})")


def connectEventConnection(stop_event=None):
    connection = DelimitedReaderConnection(readerIp, READER_EVENT_PORT, timeout=5)
    try:
        connectionId = readEventConnectionId(connection, stop_event=stop_event, timeout=5)
        registerEventConnectionId(connectionId)
        return connection
    except Exception:
        # Never reuse a partially registered event session: the Titan rejects
        # duplicate registration. The caller will retry with a fresh ID.
        connection.close()
        raise


def setActiveEventConnection(connection):
    global activeEventConnection
    with activeEventConnectionLock:
        activeEventConnection = connection


def closeActiveEventConnection():
    global activeEventConnection
    with activeEventConnectionLock:
        connection = activeEventConnection
        activeEventConnection = None
    if connection is not None:
        try:
            connection.close()
        except OSError:
            pass


