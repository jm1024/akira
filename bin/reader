def parseEvent(event):

    global arrivals
    global reports
    #global reportsSlow

    vals = event.split(" ")

    #full arrive event
    if vals[0] == "event.tag.arrive":
        #if DEBUG_ARRIVE:
        #    print("+++++++++++++++++++++++++")
        #    print(event)
        #    print("-------------------------")
    
        date = ""
        epc = ""
        antenna = ""
        rssi = ""
        tid = ""
        userData = ""
        tidAuthentic = ""
        pwAuthentic = ""
    
        for val in vals:
            d = val.split('=')
            if d[0] == "first":
                date = d[1].strip(',')
            if d[0] == "tag_id":
                epc = d[1][2:]
                epc = epc.strip(',')
            if d[0] == "antenna":
                antenna = d[1].strip(',')
            if d[0] == "rssi":
                rssi = d[1]
                rssi = rssi.strip(',')
            if d[0] == "tid":
                tid = d[1]
                tid = tid.strip(',')
                if tid.startswith("0x"): #strip leading hex stuff
                    tid = tid[2:]
            if d[0] == "user_data":
                    userData = d[1]
                    userData = userData.strip(',')
            if d[0] == "tid_authentic":
                tidAuthentic = d[1]
                tidAuthentic = tidAuthentic.strip(',')
            if d[0] == "pw_authentic":
                pwAuthentic = d[1]
                pwAuthentic = pwAuthentic.strip(',')
    
        try:
            if len(tid) > 24:
                #print("reader: trim: " +str(tid))
                tid = tid[:24]
                #print("reader: done: " +str(tid))
        except Exception as ex:
            print("ERROR: reader: truncating tid: " + str(ex))
    
        arrival = {'date':date, 'antenna':antenna, 'rssi':rssi, 'tid':tid, 'userData':userData, 'tidAuthentic':tidAuthentic, 'pwAuthentic':pwAuthentic}
    
    
        if DEBUG_ARRIVE:
            output = "==============================================="
            output = output + "\n" + str(date)
            output = output + "\n ant: " + str(antenna)
            output = output + " epc: " + str(epc)    
            output = output + "\n tid: " + str(tid)
            output = output + " user: "+  str(userData)
            output = output + "\n auth: " + str(pwAuthentic)
            output = output + " rssi: "+  str(rssi)
            output = output + "\n--------------------------------------------"
            print(output)
    
        arrivals[epc] = arrival
        
        #driver for fast read transmits to other systems
        #dt, reader, lane, side, antenna, rssi, epc, tid, userData, tidAuthentic, pwAuthentic
        lane = 0
        side = "unknown"
        id = str(uuid.uuid4())
        for thisAntenna in antennas:
            if str(thisAntenna.get('number')) == str(antenna):
                lane = thisAntenna.get('lane')
                side = thisAntenna.get('side')
        arrival['id'] = id
        arrival['lane'] = lane
        arrival['side'] = side
        
        #moved to depart - no
        for driverName, driverModule in readDrivers.items():
            if DEBUG_DRIVER:
                print("running driver: " + str(driverName))
            if hasattr(driverModule, "readArrive"):
                driverModule.read(arrival)


    ##################################################################
    # report event
    if vals[0] == "event.tag.report":
        
        #if DEBUG_REPORT:
        #    print("+++++++++++++++++++++++++")
        #    print(event)
        #    print("-------------------------")
    
        date = ""
        epc = ""
        antenna = ""
        rssi = ""
        tid = ""
        userData = ""
        tidAuthentic = ""
        pwAuthentic = ""
    
        for val in vals:
            d = val.split('=')
            if d[0] == "time":
                date = d[1].strip(',')
            if d[0] == "tag_id":
                epc = d[1][2:]
                epc = epc.strip(',')
            if d[0] == "antenna":
                antenna = d[1].strip(',')
            if d[0] == "rssi":
                rssi = d[1]
                rssi = rssi.strip(',')
            if d[0] == "tid":
                tid = d[1]
                tid = tid.strip(',')
                if tid.startswith("0x"): #strip leading hex stuff
                    tid = tid[2:]
            if d[0] == "user_data":
                    userData = d[1]
                    userData = userData.strip(',')
            if d[0] == "tid_authentic":
                tidAuthentic = d[1]
                tidAuthentic = tidAuthentic.strip(',')
            if d[0] == "pw_authentic":
                pwAuthentic = d[1]
                pwAuthentic = pwAuthentic.strip(',')
    
        try:
            if len(tid) > 24:
                #print("reader: trim: " +str(tid))
                tid = tid[:24]
                #print("reader: done: " +str(tid))
        except Exception as ex:
            print("ERROR: reader: truncating tid: " + str(ex))
    
        report = {'date':date, 'antenna':antenna, 'rssi':rssi, 'epc':epc, 'tid':tid, 'userData':userData, 'tidAuthentic':tidAuthentic, 'pwAuthentic':pwAuthentic}
        
        #driver for fast read transmits to other systems
        #dt, reader, lane, side, antenna, rssi, epc, tid, userData, tidAuthentic, pwAuthentic
        lane = 0
        side = "unknown"
        id = str(uuid.uuid4())
        for thisAntenna in antennas:
            if str(thisAntenna.get('number')) == str(antenna):
                lane = thisAntenna.get('lane')
                side = thisAntenna.get('side')
        report['id'] = id
        report['lane'] = lane
        report['side'] = side
        
        #add to appropriate list
        reports.append(report)    
        
    ##################################################################
    #depart events
    if vals[0] == "event.tag.depart": # or vals[0] == "event.tag.arrive":
        
        if DEBUG_DEPART:
            print("+++++++++++++++++++++++++")
            print(event)
            print("-------------------------")
        
        date = ""
        last = ""
        antenna = ""
        rssi = ""
        reads = ""
        epc = ""
        tid = ""
        userData = ""
        tidAuthentic = ""
        pwAuthentic = ""

        reader = readerName

        for val in vals:
            d = val.split('=')
            if d[0] == "first":
                date = d[1].strip(',')
            if d[0] == "last":
                date = d[1].strip(',')
            if d[0] == "antenna":
                antenna = d[1].strip(',')
            #if d[0] == "rssi":
            #    rssi = d[1]
            if d[0] == "rssi":
                rssi = d[1]
                rssi = rssi.strip(',')
            if d[0] == "repeat":
                reads = d[1]
                reads = reads.strip(',')
            if d[0] == "tag_id":
                epc = d[1][2:]
                epc = epc.strip(',')
            if d[0] == "tid":
                tid = d[1]
                tid = tid.strip(',')
                if tid.startswith("0x"): #strip leading hex stuff
                    tid = tid[2:]
            if d[0] == "user_data":
                userData = d[1]
                userData = userData.strip(',')
            if d[0] == "tid_authentic":
                tidAuthentic = d[1]
                tidAuthentic = tidAuthentic.strip(',')
            if d[0] == "pw_authentic":
                pwAuthentic = d[1]
                pwAuthentic = pwAuthentic.strip(',')

        if tidAuthentic == "":
            tidAuthentic = AUTH_UNKNOWN
        if pwAuthentic == "":
            pwAuthentic = AUTH_UNKNOWN

        try:
            if len(tid) > 24:
                #print("reader: trim: " +str(tid))
                tid = tid[:24]
                #print("reader: done: " +str(tid))
        except Exception as ex:
            print("ERROR: reader: truncating tid: " + str(ex))

        lane = 0
        side = "unknown"
        for thisAntenna in antennas:
            if str(thisAntenna.get('number')) == str(antenna):
                lane = thisAntenna.get('lane')
                side = thisAntenna.get('side')

        #get arrival data because.... star :(
        if epc in arrivals:
            if DEBUG_ARRIVAL_MATCH:
                print("FOUND ARRIVAL")
                print(arrivals[epc])
            rssi = arrivals[epc].get('rssi')
            date = arrivals[epc].get('date')
            if pwAuthentic == "" or pwAuthentic == AUTH_INAUTHENTIC:
                pwAuthentic = arrivals[epc].get('pwAuthentic')
            if tidAuthentic == "" or tidAuthentic == AUTH_INAUTHENTIC:
                tidAuthentic = arrivals[epc].get('tidAuthentic')
            if tid == "":
                tid = arrivals[epc].get('tid')
            if userData == "":
                userData = arrivals[epc].get('userData')
            #print(arrivals)
            arrivals = sidraCore.removeDictKey(arrivals, epc)
            #print(arrivals)
        else:
            print("NO ARRIVAL DATA")
            if DEBUG_ARRIVAL_MATCH:
                print("NO ARRIVAL DATA")
            sidraCore.log("NO ARRIVAL DATA: " + str(epc))
            

        #print(epc)
        #print(tid)
        #print(userData)

        #if no arrival then use last because.... welp
        if date == "":
            print("NO ARRIVAL EVENT")
            date = last

        #if id.startswith(TAG_FILTER):
        if DEBUG_TIMING:
            print("times - reader: " + str(date) + " server: " + str(datetime.now()))
        transaction(date, reader, lane, side, antenna, rssi, reads, epc, tid, userData, tidAuthentic, pwAuthentic)

#######################
def transaction(date, reader, lane, side, antenna, rssi, reads, epc, tid, userData, tidAuthentic, pwAuthentic):

    # get plate and class from userData
    tagPlate, tagClass = sidraCore.decodeUserData(userData)

    trnId = str(uuid.uuid4())

    trn = sidraCore.trnPrefix() + trnId
    tDate = str(date) #datetime.now()
    #print(" ------>DT " + str(dt))
    #print("RSSI trans: " + str(rssi))
    
    #if DEBUG_TIMING:
    #   print("tDate: " + str(tDate))

    tData = {
        'id': trnId,
        'date': str(date),
        'reader': reader,
        'lane': lane,
        'side': side,
        'antenna': antenna,
        'ip': readerIp,
        'ts': date,
        'rssi': rssi,
        'reads': reads,
        'tid': tid,
        'epc': epc,
        'userData': userData,
        'tagPlate': tagPlate,
        'tagClass': tagClass,
        "tidAuthentic": tidAuthentic,
        "pwAuthentic": pwAuthentic,
    }
    
    #print("RD: " + str(readDrivers))
    #for driver in readDrivers:
    #    print("DRIVER: " + driver)
    #    driver.read(tData)
    #driverRts.read(tData)
    
    tDate = sidraCore.rfStrToDt(tDate)
    #sAuth = "n"
    #if pwAuthentic == "AUTHENTIC":
    #    sAuth = "y"
        
    if DEBUG_FINAL:
        output = "==============================================="
        output = output + "\n" + str(tDate)
        output = output + "\n lane: " + str(lane)
        output = output + " ant: " + str(antenna)
        output = output + " epc: " + str(epc)    
        output = output + "\n tid: " + str(tid)
        output = output + " user: "+  str(userData)
        output = output + "\n auth: " + str(pwAuthentic)
        output = output + " rssi: "+  str(rssi)
        output = output + " reads: "+  str(reads)
        output = output + "\n--------------------------------------------"
        print(output)
    
    #drivers
    #for driverName, driverModule in readDrivers.items():
    #    if DEBUG_DRIVER:
    #        print("running driver: " + str(driverName))
    #    if hasattr(driverModule, "read"):
    #        driverModule.read(tData)
    
    sidraCore.saveTransaction(trn + sidraCore.TRN_EXTENSION_READER, json.dumps(tData, default=sidraCore.jsonConverter))



    output = str(tDate)
    output = output + " RF  > lane: " + str(lane)
    output = output + " ant: " + str(antenna)
    output = output + " epc: " + str(epc)    
    output = output + " tid: " + str(tid)
    output = output + " user: "+  str(userData)
    output = output + " auth: " + str(pwAuthentic)
    output = output + " rssi: "+  str(rssi)
    output = output + " reads: "+  str(reads)
    #output = output + " tagP: " + str(tagPlate)
    #output = output + " date: " + str(dt)

    sidraCore.log(output)

##################################################
# threads
##################################################

#######################
def rfThread(stop_event):
    
    while not stop_event.is_set():
        event = recvEvent()
        rfQ.put(event)

#######################
def massThread(stop_event):
    
    global lane
    global massName
    global massPinTrip
    global massPinMain
    global massPinRear
    global massIp
    global tnConn
    #print("massThread init: " + str(lane))
    
    for mass in sidraCore.massSensors:
        if mass["lane"] == lane:
            massName = mass["name"]
            #lane = mass["lane"]
            massIp = mass["ip"]
            massPinTrip = mass['trip']
            massPinMain = mass['main']
            massPinRear = mass['rear']
    
    if DEBUG:
        print(f"Connecting to Numato GPIO @ {massIp}:{MASS_PORT}")
    
    tnConn = None
    
    try:
        tnConn = telnetlib.Telnet(massIp, MASS_PORT, timeout=5)
    
        # explicitly own both SIGINT (^C) and SIGHUP
        #signal.signal(signal.SIGINT, handleSignal)
        #signal.signal(signal.SIGHUP, handleSignal)
    
        login(tnConn)
        setAllInputsAndNotify(tnConn)
        monitorNotifications(tnConn, stop_event)
        
    except Exception as ex:
        print("massThread(): " + str(ex))
        
    
    #while not stop_event.is_set():
    #    event = massEvent()
    #    massQ.put(event)

#######################
def laneThread(stop_event):
    
    massTrip = 0
    massMain = 0
    massDate = datetime.now()
    
    lastMassTrip = -1
    lastMassMain = -1
    lastMassDate = datetime.now()
    
    fastWindow = resetWindow([]) #{'locked':False,'reading':False,'begin':datetime.now(),'end':datetime.now(),'updated':datetime.now()}
    slowWindow = resetWindow([]) #{'locked':False,'reading':False,'begin':datetime.now(),'end':datetime.now(),'updated':datetime.now()}
    
    massUpdated = False
    
    while not stop_event.is_set():
        updates = False
        rfUpdated = False
        massUpdated = False
    
        #receive rf updates
        while True:
            try:
                event = rfQ.get_nowait()
                if event is STOP:
                    stop_event.set()
                    return
                #print("rf event:")
            except queue.Empty:
                break
    
            parseEvent(event)
            #print("laneThread received:")
            rfUpdated = True
            updates = True
            rfQ.task_done()
        
        #receive mass updates
        while True:
            try:
                massEvent = massQ.get_nowait()
                if massEvent is STOP:
                    stop_event.set()
                    return
                print("massEvent: " + str(massEvent))
            except queue.Empty:
                break
                
            massUpdated = True
            updates = True
            massQ.task_done()
    
        # if no updates yield CPU
        if not updates:
            #print("yield")
            time.sleep(0.001)  # 1ms
        #else:
        #    print("NO YIELD")
        
        # if mass has changed state - set windows
        if massUpdated:
            massTrip = massEvent.get("trip",-1)
            massMain = massEvent.get("main",-1)
            massRear = massEvent.get("rear",-1)
            massDate = massEvent.get("date")
            
            #if clear unlock and reset windows
            if massMain == 0 and massTrip == 0:
                fastWindow = resetWindow()
                slowWindow = resetWindow()
            
            #if theres a change in trip and slow is not locked
            if massTrip == 1 and not massTrip == lastMassTrip and slowWindow['locked'] == False:
                begin = massDate + timedelta(milliseconds=WINDOW_FAST_PRE)
                end   = massDate + timedelta(milliseconds=WINDOW_FAST_POST)
                fastWindow = readWindow(fastWindow, begin, end)
                
            #if theres a change in main lock fast, unlock slow
            if massMain == 1 and lastMassMain == 0:
                begin = massDate + timedelta(milliseconds=WINDOW_SLOW_PRE)
                end   = massDate + timedelta(milliseconds=WINDOW_SLOW_POST)
                fastWindow = lockWindow()
                slowWindow = readWindow(slowWindow, begin, end)
            
            #save current state to last
            lastMassTrip = massTrip
            lastMassMain = massMain
            lastMassRear = massRear
            lastMassDate = massDate
            
            if DEBUG_MASS:
                fastBegin = fastWindow['begin'].time()
                fastEnd = fastWindow['end'].time()
                fastUpdated = fastWindow['updated'].time()
                slowBegin = slowWindow['begin'].time()
                slowEnd = slowWindow['end'].time()
                slowUpdated = slowWindow['updated'].time()
                print(f"FAST b:{fastBegin} e:{fastEnd} u:{fastUpdated} l:{fastWindow['locked']} r:{fastWindow['reading']}")
                print(f"SLOW b:{slowBegin} e:{slowEnd} u:{slowUpdated} l:{slowWindow['locked']} r:{slowWindow['reading']}")

            
        #if rfUpdated:
        #    print("RFU")
            
        #clean old rf events
        cleanOldRf()

#######################   
def readWindow(window, begin, end):
    
    window['locked'] = True
    window['reading'] = True
    window['begin'] = begin
    window['end'] = end
    window['updated'] = datetime.now()
    
    return window

#######################   
def lockWindow():
    
    window['locked'] = True
    window['reading'] = False
    window['begin'] = datetime.now()
    window['end'] = datetime.now()
    window['updated'] = datetime.now()
    
    return window

#######################   
def resetWindow():
    
    window = {}
    window['locked'] = False
    window['reading'] = False
    window['begin'] = datetime.now()
    window['end'] = datetime.now()
    window['updated'] = datetime.now()
    
    return window

#######################
def cleanOldRf():
    
    global reports

    now = datetime.now()
    cutoff = now - timedelta(seconds=MAX_REPORT_AGE)

    reports[:] = [
        r for r in reports
        if datetime.fromisoformat(r['date']) >= cutoff
    ]

############################################
# thread control

#######################
def startThreads():
    
    stop_event = threading.Event()

    tRecv = threading.Thread(target=rfThread, args=(stop_event,), name="rfThread", daemon=True)
    tMass = threading.Thread(target=massThread, args=(stop_event,), name="massThread", daemon=True)
    tLane = threading.Thread(target=laneThread, args=(stop_event,), name="laneThread", daemon=True)

    tRecv.start()
    tMass.start()
    tLane.start()

    return stop_event, (tRecv, tMass, tLane)

#######################
def stopThreads(stop_event, threads):

    stop_event.set()
    
    # unblock queues
    try:
        rfQ.put_nowait(STOP)
    except Exception:
        pass
    
    try:
        massQ.put_nowait(STOP)
    except Exception:
        pass
    
    for t in threads:
        t.join(timeout=2.0)
        
