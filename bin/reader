        report['lane'] = lane
        report['side'] = side

        if LOG_READS:
            sidraCore.appendFile(LOG_READS_FILE, json.dumps(report, default=sidraCore.jsonConverter) + '\n')

        # if not squelched add
        if not isSquelched(report['tid'], report['side']):
            reports.append(report)
        #else:
        #    if DEBUG_SQUELCH:
        #        print(f" is squelched {report['tid']} {report['side']}")

    ##################################################################
    #depart events
    if vals[0] == "event.tag.depart": # or vals[0] == "event.tag.arrive":

        if DEBUG_DEPART:
            print("+++++++++++++++++++++++++")
            print(event)
            print("-------------------------")

        date = ""
