#######################
def getAntennaAssignment(antenna):
    return antennaMap.get(str(antenna))


#######################
def getLaneContext(laneValue):
    laneText = str(laneValue).strip()
    context = laneContexts.get(laneText)
    if context is not None:
        return context
    try:
        numericMatches = [
            candidate
            for configuredLane, candidate in laneContexts.items()
            if int(configuredLane) == int(laneText)
        ]
    except (TypeError, ValueError):
        return None
    return numericMatches[0] if len(numericMatches) == 1 else None


#######################
def routeReport(report):
    context = getLaneContext(report.get('lane', ''))
    if context is None:
        msg = f"reader: dropping RF event from unconfigured antenna {report.get('antenna')}"
        print(msg)
        akiraCore.log(msg)
        return False

    with context.lock:
        if isSquelched(context, report.get('tid', ''), report.get('side', '')):
            return False
        context.reports.append(report)
    return True


#######################
def parseEvent(event):

    global arrivals

    vals = event.split(" ")
    if not vals or not vals[0]:
        return

    #full arrive event
    if vals[0] == "event.tag.arrive":
        #if DEBUG_ARRIVE:
        #    print("+++++++++++++++++++++++++")
        #    print(event)
        #    print("-------------------------")

        date = ""
        epc = ""
        antenna = ""
        rssi = ""
        tid = ""
        userData = ""
        tidAuthentic = ""
        pwAuthentic = ""
        freq = ""

        for val in vals:
            d = val.split('=')
            if d[0] == "first":
                date = d[1].strip(',')
                #date = datetime.now()
            if d[0] == "tag_id":
                epc = d[1][2:]
                epc = epc.strip(',')
            if d[0] == "antenna":
                antenna = d[1].strip(',')
            if d[0] == "rssi":
                rssi = d[1]
                rssi = rssi.strip(',')
            if d[0] == "tid":
                tid = d[1]
                tid = tid.strip(',')
                if tid.startswith("0x"): #strip leading hex stuff
                    tid = tid[2:]
            if d[0] == "user_data":
                    userData = d[1]
                    userData = userData.strip(',')
            if d[0] == "tid_authentic":
                tidAuthentic = d[1]
                tidAuthentic = tidAuthentic.strip(',')
            if d[0] == "pw_authentic":
                pwAuthentic = d[1]
                pwAuthentic = pwAuthentic.strip(',')
            if d[0] == "freq":
                freq = d[1]
                freq = freq.strip(',')

        try:
            if len(tid) > 24:
                #print("reader: trim: " +str(tid))
                tid = tid[:24]
                #print("reader: done: " +str(tid))
        except Exception as ex:
            print("ERROR: reader: truncating tid: " + str(ex))

        date = datetime.now()

        arrival = {'date':date, 'antenna':antenna, 'rssi':rssi, 'tid':tid, 'userData':userData, 'tidAuthentic':tidAuthentic, 'pwAuthentic':pwAuthentic}


        if LOG_READS:
            akiraCore.appendFile(LOG_READS_FILE, json.dumps(arrival, default=akiraCore.jsonConverter) + '\n')

        if DEBUG_ARRIVE:
            output = "==============================================="
            output = output + "\n" + str(date)
            output = output + "\n ant: " + str(antenna)
            output = output + " epc: " + str(epc)
            output = output + "\n tid: " + str(tid)
            output = output + " user: "+  str(userData)
            output = output + "\n auth: " + str(pwAuthentic)
            output = output + " rssi: "+  str(rssi)
            output = output + "\n--------------------------------------------"
            print(output)

        assignment = getAntennaAssignment(antenna)
        if assignment is None:
            routeReport({'antenna': antenna})
            return
        lane = assignment['lane']
        side = assignment['side']
        id = str(uuid.uuid4())
        arrival['id'] = id
        arrival['lane'] = lane
        arrival['side'] = side

        with arrivalsLock:
            arrivals[(epc, lane)] = arrival

        #dtDate = akiraCore.rfStrToDt(date)


        report = {'date':date, 'antenna':antenna, 'rssi':rssi, 'epc':epc, 'tid':tid, 'userData':userData, 'tidAuthentic':tidAuthentic, 'pwAuthentic':pwAuthentic, 'freq':freq}

        id = str(uuid.uuid4())
        report['id'] = id
        report['lane'] = lane
        report['side'] = side

        if LOG_READS:
            akiraCore.appendFile(LOG_READS_FILE, json.dumps(report, default=akiraCore.jsonConverter) + '\n')

        routeReport(report)

    ##################################################################
    # report event
    if vals[0] == "event.tag.report":

        if DEBUG_REPORT:
        #    print("+++++++++++++++++++++++++")
            print(event)
        #    print("-------------------------")

        date = ""
        epc = ""
        antenna = ""
        rssi = ""
        tid = ""
        userData = ""
        tidAuthentic = ""
        pwAuthentic = ""
        freq = ""

        for val in vals:
            d = val.split('=')
            if d[0] == "time":
                sDate = d[1].strip(',')
                #print(f"report: {sDate} now:{datetime.now()}")
            if d[0] == "tag_id":
                try:
                    epc = d[1][2:]
                    epc = epc.strip(',')
                except:
                    print("BAD TID")
                    return
            if d[0] == "antenna":
                antenna = d[1].strip(',')
            if d[0] == "rssi":
                rssi = d[1]
                rssi = rssi.strip(',')
            if d[0] == "tid":
                tid = d[1]
                tid = tid.strip(',')
                if tid.startswith("0x"): #strip leading hex stuff
                    tid = tid[2:]
            if d[0] == "user_data":
                    userData = d[1]
                    userData = userData.strip(',')
            if d[0] == "tid_authentic":
                tidAuthentic = d[1]
                tidAuthentic = tidAuthentic.strip(',')
            if d[0] == "pw_authentic":
                pwAuthentic = d[1]
                pwAuthentic = pwAuthentic.strip(',')
            if d[0] == "freq":
                freq = d[1]
                freq = freq.strip(',')

        try:
            if len(tid) > 24:
                #print("reader: trim: " +str(tid))
                tid = tid[:24]
                #print("reader: done: " +str(tid))
        except Exception as ex:
            print("ERROR: reader: truncating tid: " + str(ex))

        #date = akiraCore.rfStrToDt(sDate)
        date = datetime.now() # <--- JM GO BACK TO TITAN TIME

        report = {'date':date, 'antenna':antenna, 'rssi':rssi, 'epc':epc, 'tid':tid, 'userData':userData, 'tidAuthentic':tidAuthentic, 'pwAuthentic':pwAuthentic, 'freq':freq}

        if DEBUG_REPORT_TERSE:
        #    print("+++++++++++++++++++++++++")
            print(tid)
        #    print("-------------------------")

        assignment = getAntennaAssignment(antenna)
        if assignment is None:
            routeReport({'antenna': antenna})
            return
        lane = assignment['lane']
        side = assignment['side']
        id = str(uuid.uuid4())
        report['id'] = id
        report['lane'] = lane
        report['side'] = side

        if LOG_READS:
            akiraCore.appendFile(LOG_READS_FILE, json.dumps(report, default=akiraCore.jsonConverter) + '\n')

        routeReport(report)

    ##################################################################
    #depart events
    if vals[0] == "event.tag.depart": # or vals[0] == "event.tag.arrive":

        if DEBUG_DEPART:
            print("+++++++++++++++++++++++++")
            print(event)
            print("-------------------------")

        date = ""
        last = ""
        antenna = ""
        rssi = ""
        reads = ""
        epc = ""
        tid = ""
        userData = ""
        tidAuthentic = ""
        pwAuthentic = ""

        reader = readerName

        for val in vals:
            d = val.split('=')
            if d[0] == "first":
                date = d[1].strip(',')
            if d[0] == "last":
                date = d[1].strip(',')
            if d[0] == "antenna":
                antenna = d[1].strip(',')
            #if d[0] == "rssi":
            #    rssi = d[1]
            if d[0] == "rssi":
                rssi = d[1]
                rssi = rssi.strip(',')
            if d[0] == "repeat":
                reads = d[1]
                reads = reads.strip(',')
            if d[0] == "tag_id":
                epc = d[1][2:]
                epc = epc.strip(',')
            if d[0] == "tid":
                tid = d[1]
                tid = tid.strip(',')
                if tid.startswith("0x"): #strip leading hex stuff
                    tid = tid[2:]
            if d[0] == "user_data":
                userData = d[1]
                userData = userData.strip(',')
            if d[0] == "tid_authentic":
                tidAuthentic = d[1]
                tidAuthentic = tidAuthentic.strip(',')
            if d[0] == "pw_authentic":
                pwAuthentic = d[1]
                pwAuthentic = pwAuthentic.strip(',')

        if tidAuthentic == "":
            tidAuthentic = AUTH_UNKNOWN
        if pwAuthentic == "":
            pwAuthentic = AUTH_UNKNOWN

        try:
            if len(tid) > 24:
                #print("reader: trim: " +str(tid))
                tid = tid[:24]
                #print("reader: done: " +str(tid))
        except Exception as ex:
            print("ERROR: reader: truncating tid: " + str(ex))

        assignment = getAntennaAssignment(antenna)
        if assignment is None:
            routeReport({'antenna': antenna})
            return
        lane = assignment['lane']
        side = assignment['side']

        #get arrival data because.... star :(
        arrivalKey = (epc, lane)
        with arrivalsLock:
            arrival = arrivals.pop(arrivalKey, None)
        if arrival is not None:
            if DEBUG_ARRIVAL_MATCH:
                print("FOUND ARRIVAL")
                print(arrival)
            rssi = arrival.get('rssi')
            date = arrival.get('date')
            if pwAuthentic == "" or pwAuthentic == AUTH_INAUTHENTIC:
                pwAuthentic = arrival.get('pwAuthentic')
            if tidAuthentic == "" or tidAuthentic == AUTH_INAUTHENTIC:
                tidAuthentic = arrival.get('tidAuthentic')
            if tid == "":
                tid = arrival.get('tid')
            if userData == "":
                userData = arrival.get('userData')
        else:
            #print("NO ARRIVAL DATA")
            if DEBUG_ARRIVAL_MATCH:
                print("NO ARRIVAL DATA")
            akiraCore.log(f"NO ARRIVAL DATA lane:{lane}: {epc}")


        #print(epc)
        #print(tid)
        #print(userData)

        #if no arrival then use last because.... welp
        if date == "":
            print("NO ARRIVAL EVENT")
            date = last

        #if id.startswith(TAG_FILTER):
        if DEBUG_TIMING:
            print("times - reader: " + str(date) + " server: " + str(datetime.now()))
        #transaction(date, reader, lane, side, antenna, rssi, reads, epc, tid, userData, tidAuthentic, pwAuthentic)

