#!/usr/bin/python3
import os
import json
import requests
import sidraCore

# Define file paths
AKIRA_FILE = "akiraEnabled.rts"

#######################################
def checkFile(file_path):
    try:
        if sidraCore.readFile(file_path).strip() == "True":
            return "True"
    except Exception as ex:
        msg = f"tmpCron checkFile() error: {ex}"
        print(msg)
        sidraCore.log(msg)
        
    return "False"
#######################################

def localXmitEvent(url, payload):
    """
    Transmits the payload to the API. 
    Since we use SSH for commands now, we only care if the API received this (200 OK).
    """
    try:
        headers = {'Content-type': 'application/json'}
        resp = requests.post(url, headers=headers, data=payload, timeout=5)
        
        if resp.status_code == 200:
            return True
        else:
            op_name = json.loads(payload).get('op', 'Unknown')
            msg = f"ERROR xmit {url} {op_name} resp: {resp.status_code}"
            print(msg)
            sidraCore.log(msg)
            return False
            
    except Exception as ex:
        msg = f"Error transmitting to API {url}: {ex}"
        print(msg)
        sidraCore.log(msg)
        return False

#######################################

def main():
    data = {}
    
    akiraPath = os.path.join(sidraCore.TMP_DIR, AKIRA_FILE)
    if os.path.exists(akiraPath):
        data['akiraEnabled'] = checkFile(akiraPath)
    
    if not data:
        print("No files found to transmit.")
        return
        
    data['op'] = 'updateTmp'
    payload = json.dumps(data)
    print(f"Transmitting data: {payload}")
    
    apis = sidraCore.sidraApiList()
    if not apis:
        msg = "xmit: no sidraApi configured"
        print(msg)
        sidraCore.log(msg)
        return
        
    failedTargets = []

    for api in apis:
        success = localXmitEvent(api, payload)
        if not success:
            failedTargets.append(api)

    if failedTargets:
        msg = f"Failed to transmit to these APIs: {failedTargets}"
        print(msg)
        sidraCore.log(msg)
    else:
        print("Successfully updated all APIs.")

if __name__ == "__main__":
    main()