#!/usr/bin/env python3
import subprocess
import sys
import time
import akiraCore

commands = [
	akiraCore.BIN_DIR + "/cam",
	akiraCore.BIN_DIR + "/readerInit",
	akiraCore.BIN_DIR + "/lidar",
	akiraCore.BIN_DIR + "/mcp",
	akiraCore.BIN_DIR + "/xmit",
]

#akiraCore.BIN_DIR + "/massInit",

#commands = []

for driverXmit in akiraCore.driversXmit:
	commands.append(akiraCore.BIN_DIR + "/" + driverXmit)
	
for driverServer in akiraCore.driversServer:
	commands.append(akiraCore.BIN_DIR + "/" + driverServer)

#############################
def startProcesses(dryRun=False):

	processList = []
	for cmd in commands:
		if dryRun:
			print("DRY RUN: " + cmd)
			continue

		print(cmd)
		try:
			proc = subprocess.Popen([cmd])
			processList.append(proc)
			print(f"Started {cmd} with PID {proc.pid}", flush=True)
		except Exception as e:
			print(f"Failed to start {cmd}: {e}", flush=True)
	return processList


#############################
def main():
	dryRun = "--dry-run" in sys.argv
	processList = startProcesses(dryRun=dryRun)

#############################
if __name__ == "__main__":
	main()
