#!/usr/bin/env python3
import sys
import time
import telnetlib

USER = b"admin"
PASS = b"admin"
PORT = 23

RELAY_INDEX = "000"  # change to 1 if firmware is 1-based

#######################
def state_to_cmd(s: str) -> bytes:
    v = s.strip().lower()
    if v in ("1", "on", "true", "high"):
        return b"on"
    if v in ("0", "off", "false", "low"):
        return b"off"
    raise ValueError("state must be 0/1 or off/on")

##############################################
def main() -> int:
    if len(sys.argv) != 3:
        print("Usage: readerSwitch <ip> <state>", file=sys.stderr)
        return 2

    ip = sys.argv[1]
    try:
        onoff = state_to_cmd(sys.argv[2])
    except ValueError as e:
        print(e, file=sys.stderr)
        return 2

    # Initialize tn as None so the 'finally' block doesn't crash if Telnet() fails
    tn = None 

    try:
        tn = telnetlib.Telnet(ip, PORT, timeout=5)

        # Wait for "User Name:" then send username
        tn.read_until(b"User Name", timeout=5)
        tn.write(USER + b"\r\n")

        # Wait for "Password:" then send password
        tn.read_until(b"Password", timeout=5)
        tn.write(PASS + b"\r\n")

        # Give it a moment and read whatever it prints
        time.sleep(0.2)
        out = tn.read_very_eager().lower()
        
        if b"denied" in out or b"bad user" in out:
            print("Auth failed: access denied", file=sys.stderr)
            return 3  # The finally block will still run before it actually returns

        # Send relay command
        cmd = b"relay " + onoff + b" " + str(RELAY_INDEX).encode("ascii") + b"\r\n"
        tn.write(cmd)

        time.sleep(0.2)
        resp = tn.read_very_eager().decode("ascii", errors="replace").strip()
        print(resp if resp else "Command sent.")
        
        return 0

    except Exception as e:
        # Catch network timeouts or device disconnects mid-stream
        print(f"Telnet communication error: {e}", file=sys.stderr)
        return 1

    finally:
        # 2. GUARANTEED EXECUTION: This runs no matter how the try block exits
        if tn is not None:
            try:
                tn.close()
            except Exception:
                pass  # Ignore errors while closing; we just want to ensure it's closed

##############################################
if __name__ == "__main__":
    raise SystemExit(main())