#!/bin/bash

if [ "$(id -u)" -ne 0 ]; then
  echo "ERROR: disableWatchdog must run as root so it updates the live watchdog crontab." >&2
  exit 1
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
COMMAND="$SCRIPT_DIR/watchdog"
CRON_FILE="$(mktemp)"
NEXT_CRON="$(mktemp)"
trap 'rm -f -- "$CRON_FILE" "$NEXT_CRON"' EXIT

crontab -l 2>/dev/null > "$CRON_FILE" || true
awk -v command="$COMMAND" 'index($0, command) == 0' "$CRON_FILE" > "$NEXT_CRON"

echo "disabling watchdog in cron"
crontab "$NEXT_CRON"
