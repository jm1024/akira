#!/bin/bash

if [ "$(id -u)" -ne 0 ]; then
  echo "ERROR: enableWatchdog must run as root so it updates the live watchdog crontab." >&2
  exit 1
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
ENTRY="*/1 * * * * $SCRIPT_DIR/watchdog"
CRON_FILE="$(mktemp)"
trap 'rm -f -- "$CRON_FILE"' EXIT

crontab -l 2>/dev/null > "$CRON_FILE" || true

echo "enabling watchdog in cron"
if grep --fixed-strings --line-regexp --quiet -- "$ENTRY" "$CRON_FILE"; then
  echo " - cron already configured"
else
  printf '%s\n' "$ENTRY" >> "$CRON_FILE"
  crontab "$CRON_FILE"
fi
