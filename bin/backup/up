#!/usr/bin/env python3
import subprocess
import time
import akiraCore

commands = [
	"/var/akira/bin/cam",
	"/var/akira/bin/readerInit",
	"/var/akira/bin/lidar",
	"/var/akira/bin/mcp",
	"/var/akira/bin/xmit",
]

#"/var/akira/bin/massInit",

#commands = []

for driverXmit in akiraCore.driversXmit:
	commands.append("/var/akira/bin/" + driverXmit)
	
for driverServer in akiraCore.driversServer:
	commands.append("/var/akira/bin/" + driverServer)

#############################
def startProcesses():

	processList = []
	for cmd in commands:
		print(cmd)
		try:
			proc = subprocess.Popen([cmd])
			processList.append(proc)
			print(f"Started {cmd} with PID {proc.pid}", flush=True)
		except Exception as e:
			print(f"Failed to start {cmd}: {e}", flush=True)
	return processList


#############################
def main():
	processList = startProcesses()

#############################
if __name__ == "__main__":
	main()