#!/usr/bin/python3
import subprocess
import sys
from datetime import datetime
import json

sys.path.append('/var/akira/bin')

import akiraCore
import monCore


###############################################################
# main
###############################################################

bOk = True

# check driver processes
if not akiraCore.isRunning("cam"):
    akiraCore.log("watchdog: cam down")
    bOk = False

for reader in akiraCore.readers:
    if not akiraCore.isRunning("reader " + reader['name']):
        akiraCore.log("watchdog: reader " + reader['name'] + " down")
        bOk = False

if not akiraCore.isRunning("lidar"):
    akiraCore.log("watchdog: lidar down")
    bOk = False

if not akiraCore.isRunning("mcp"):
    akiraCore.log("watchdog: mcp down")
    bOk = False

if not akiraCore.isRunning("xmit"):
    akiraCore.log("watchdog: xmit down")
    bOk = False

#check drivers
for driverXmit in akiraCore.driversXmit:
    if not akiraCore.isRunning(driverXmit):
        bOk = False
for driverServer in akiraCore.driversServer:
        if not akiraCore.isRunning(driverServer):
            bOk = False

if not bOk:
    print("Restarting Sidra")
    akiraCore.log("watchdog: Restarting Sidra")
    cmd = akiraCore.BIN_DIR + "/restart"
    subprocess.call([cmd])
    #ps = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE)

#local image server
if not akiraCore.isRunning("http.server"):
    akiraCore.log("watchdog: localImageServer down")
    #print("Restarting localImageServer")
    akiraCore.log("watchdog: Restarting localImageServer")
    cmd = akiraCore.BIN_DIR + "/localImageServer"
    subprocess.call([cmd])
    #ps = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE)

#mon active
if not akiraCore.isRunning(akiraCore.BIN_DIR + "/mon"):
    akiraCore.log("watchdog: mon down")
    #print("Restarting localImageServer")
    akiraCore.log("watchdog: Restarting mon")
    cmd = akiraCore.BIN_DIR + "/mon"
    subprocess.call([cmd])

#mon
data = monCore.getAll(akiraCore.ipList)
now = datetime.now()
monFileName = now.strftime("%Y%m%d%H%M") + ".mon"
akiraCore.writeFile(monCore.MON_PATH + monFileName, json.dumps(data, indent=2))

#purge image files
#akiraCore.log("Watchdog Purging Images")
akiraCore.purgeImageFiles()

#purge image files
#akiraCore.log("Watchdog Purging Images")
akiraCore.purgeTransactionFiles()
