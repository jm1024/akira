#!/bin/bash
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
AKIRA_ROOT="${AKIRA_ROOT:-$(dirname -- "$SCRIPT_DIR")}"
echo Total:
grep epc "$AKIRA_ROOT/log/akira.log" | wc -l
echo Inuthentic:
grep INAUTHENTIC "$AKIRA_ROOT/log/akira.log" | wc -l
echo Unknown:
grep UNKNOWN "$AKIRA_ROOT/log/akira.log" | wc -l
