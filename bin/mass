#!/usr/bin/env python3
import time
import argparse
import sys
import os
import json
import signal
import traceback
from datetime import datetime, timedelta

import akiraCore
import massSensor
from numatoTelnet import NumatoConnection

PORT = 23

USERNAME = "admin"
PASSWORD = "admin"

WINDOW_FAST_PRE = -1
WINDOW_FAST_POST = 1 #.5 # set to 1?

DEBUG = False
DEBUG_STATE = True

name = ""
lane = ""
ip = ""
massConfig = {}
state = {}

locked = False
lastLock = datetime.now() + timedelta(seconds=10)

stateTime = datetime.now()
lastState = {}
lastTime = datetime.now()
#previousState = {}
#previousTime = datetime.now()

lastBegin = datetime.now()
lastEnd = datetime.now()

lastTripState = 0
lastMassState = 0

tnConn = None


#############################
def monitorNotifications(tn):
    
    global state
    global stateTime
    #global lastState
    #global lastTime
    #global previousState
    #global previousTime
    
    print("Monitoring GPIO")
    print("--------------------")
    try:
        while True:
            # read one line-ish at a time
            data = tn.readline(timeout=1)
            if not data:
                continue
            text = data.strip()
            if not text:
                continue
            
            #previousState = lastState
            #previousTime = lastTime    
            #lastState = state
            #lastTime = stateTime
            state = parseGpio(text)
            if state is None:
                continue
            
            #massRules(tripState, mainState, stateTime, lastTripState, lastMainState, lastTime, previousTripState, previousMainState, previousTime)
            updateMass(state)
                
                #print(state)
                #print("EVENT RAW:", text)
    except Exception as ex:
        print("Exception in monitorNotification: " + str(ex))
        traceback.print_exc()

#############################
def readUntil(tn, marker, timeout=.5):
    """Read until a text marker is seen or timeout expires."""
    if DEBUG:
        print(f"readUntil({marker!r})")
    data = tn.read_until(marker, timeout=timeout)
    if DEBUG and data:
        print("<<", data)
    return data


#############################
def sendLine(tn, line):
    """Send a line terminated with CRLF."""
    if DEBUG:
        print(">>", line)
    tn.write_line(line)


#############################
def login(tn):
    # Wait for "User Name:" prompt
    readUntil(tn, "User Name:", timeout=5)

    # Send username
    sendLine(tn, USERNAME)

    # Wait for "Password:" prompt
    readUntil(tn, "Password:", timeout=5)

    # Send password
    sendLine(tn, PASSWORD)

    # Read a little bit of what comes next
    time.sleep(0.2)
    text = tn.read_available(timeout=0.2)

    if DEBUG and text:
        print("LOGIN RESPONSE RAW:\n", text)

    if "Access denied" in text:
        print("LOGIN FAILED (Access denied)")
        raise SystemExit(1)

    # If no explicit error, treat as success
    print("Logged in OK")


#############################
def setAllInputsAndNotify(tn):
    """
    - iomask: affect all 16 bits
    - iodir: 1 = input, so ffff = all inputs
    - readall once (and set initial global state)
    - enable notifications
    """
    global state

    # iomask: affect all 16 bits
    sendLine(tn, "gpio iomask ffff")
    tn.read_available(timeout=0.2)

    # iodir: 1 = input, so ffff = all inputs
    sendLine(tn, "gpio iodir ffff")
    tn.read_available(timeout=0.2)

    # initial read
    sendLine(tn, "gpio readall")
    resp = tn.read_available(timeout=0.2)

    if resp:
        text = resp.strip()
        if DEBUG:
            print("READALL:\n", text)

        parsed = parseGpio(text)
        if parsed is not None:
            state = parsed
            updateMass(parsed)
            if DEBUG:
                print(state)

    # enable notifications
    sendLine(tn, "gpio notify on")
    tn.read_available(timeout=0.2)

#############################
def parseGpio(text):
    return massSensor.parseGpio(text)
        
#############################
def updateMass(current):
    global locked
    global lastLock
    global lastLockState
    global lastBegin
    global lastEnd
    global lastTripState
    global lastMassState

    logicalState = massSensor.logicalState(current, massConfig)
    massEvent = {
        "name": name,
        "lane": lane,
        "date": datetime.now(),
        **logicalState,
    }
    tripState = logicalState["fast"]
    massState = logicalState["mid"]
    slowState = logicalState["slow"]
    try:
        lastLockState = akiraCore.massLock(name)
    except Exception:
        lastLockState = {"locked": False, "begin": "", "end": "", "count": 0}

    #if DEBUG_STATE:
    #    print(str(massEvent['date']) + " fast: " + str(tripState) + " mid: " + str(massState))

    newLock = {}
    newLock['locked'] = "ERR"
    newLock['begin'] = ""
    newLock['end'] = ""
    newLock['count'] = lastLockState['count']
    
    
    if tripState == 1 and lastTripState == 0:
        newLock['count'] = lastLockState['count'] + 1
        
    lastTripState = tripState
    lastMassState = massState

    unlockLockout = False
    updateLock = False
    if not locked:
        if logicalState["occupied"]:
            locked = True
            lastLock = datetime.now()
            updateLock = True
    else:
        if not logicalState["occupied"]:
            clearDelaySeconds = massConfig["clearDebounceMs"] / 1000.0
            unlockAt = lastLock + timedelta(seconds=clearDelaySeconds)
            if massEvent['date'] < unlockAt:
                unlockLockout = True
                print("LOCKED too recently - not unlocking")
            else:
                locked = False
                updateLock = True
                newLock['count'] = 0

    #if the lane was locked recently dont update the unlock
    if not unlockLockout:
        newLock['locked'] = locked
        
        # If this was a lock triggered by fast, set the legacy lock window.
        if locked == True and tripState == 1:
            updateLock = True
            if massState == 1 or slowState == 1:
                newLock['begin'] = lastLockState['begin'] #lastBegin
                newLock['end'] = lastLockState['end'] #lastEnd
            else:
                newLock['begin'] = massEvent['date'] + timedelta(seconds=WINDOW_FAST_PRE)
                newLock['end'] = massEvent['date'] + timedelta(seconds=WINDOW_FAST_POST)
                lastBegin = newLock['begin']
                lastEnd = newLock['end']

        #see if the lane is already locked by something else - dont set window
        try:
            fileMass = akiraCore.massLock(name)
        except Exception:
            fileMass = lastLockState
        if  fileMass['locked']:
            print("override lock set") 
            newLock['end'] = ""
            newLock['begin'] = ""
            #updateLock = False

    if updateLock:
        akiraCore.massLockSet(name, newLock)
        debugMsg = (
            "updateMass "
            + " c: " + str(newLock['count'])
            + " f: " + str(tripState)
            + " m: " + str(massState)
            + " s: " + str(slowState)
            + " locked: " + str(newLock['locked'])
        )

        if not newLock['end'] == "" and locked == True:
            debugMsg = debugMsg + " window:" + str(newLock['end'])
        print(debugMsg)
    output = json.dumps(massEvent, default=akiraCore.jsonConverter)
    fileName = akiraCore.MASS_DIR + "/" + str(lane) + akiraCore.STATE_EXTENSION_MASS
    akiraCore.writeFile(fileName, output)

#############################
def handleSignal(signum, frame):
    global tnConn

    if DEBUG:
        print(f"handleSignal: received signal {signum}", flush=True)

    if tnConn is not None:
        try:
            if DEBUG:
                print("handleSignal: sending 'gpio notify off' and closing telnet", flush=True)
            try:
                sendLine(tnConn, "gpio notify off")
                time.sleep(0.1)
            except Exception:
                pass
            try:
                tnConn.close()
            except Exception:
                pass
        finally:
            tnConn = None

    # exit cleanly (this raises SystemExit, so finally in main will still run)
    sys.exit(0)

##########################################################
if __name__ == "__main__":

    # debug so we can see what Python sees
    if DEBUG:
        print("ARGV:", sys.argv)

    parser = argparse.ArgumentParser(prog="mass")
    parser.add_argument(
        "name",
        nargs="?",
        default=""
    )

    args = parser.parse_args()

    name = args.name

    for mass in akiraCore.massSensors:
        #print(name)
        #print(mass["name"])
        #print(mass["ip"])
        #print(mass["lane"])
        if mass["name"] == name:
            name = mass["name"]
            lane = mass["lane"]
            ip = mass["ip"]
            massConfig = massSensor.normalizeConfig(mass)
            #if DEBUG:
            #    print(mass)

    if not massConfig:
        print(f"Unknown mass sensor: {name}", file=sys.stderr)
        raise SystemExit(2)

    if DEBUG:
        print(f"Connecting to Numato GPIO @ {ip}:23")

    tnConn = None

    try:
        tnConn = NumatoConnection(ip, PORT, timeout=5)

        # explicitly own both SIGINT (^C) and SIGHUP
        signal.signal(signal.SIGINT, handleSignal)
        signal.signal(signal.SIGHUP, handleSignal)

        login(tnConn)
        setAllInputsAndNotify(tnConn)
        monitorNotifications(tnConn)

    except KeyboardInterrupt:
        # This might still happen if SIGINT is not delivered for some reason
        if DEBUG:
            print("\nCtrl+C received (KeyboardInterrupt), cleaning up...", flush=True)

    finally:
        # Final safety net: if for any reason tnConn is still open, close it here.
        if tnConn is not None:
            if DEBUG:
                print("main: cleaning up telnet (finally)...", flush=True)
            try:
                sendLine(tnConn, "gpio notify off")
                time.sleep(0.1)
            except Exception:
                pass
            try:
                tnConn.close()
            except Exception:
                pass
            tnConn = None
