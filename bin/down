#!/usr/bin/env python3
import subprocess
import sys
import time
import akiraCore

processes = ["cam", "reader", "mass", "lidar", "mcp", "xmit"]
BASE_DIR = akiraCore.BIN_DIR
SLEEP_SECONDS = 8.0

for driverXmit in akiraCore.driversXmit:
	processes.append(driverXmit)
	
for driverServer in akiraCore.driversServer:
	processes.append(driverServer)

#############################
def runPkill(signalOption, dryRun=False):
	for name in processes:
		pattern = f"{BASE_DIR}/{name}"
		if dryRun:
			print(f"DRY RUN: pkill {signalOption} -f {pattern}")
			continue

		try:
			subprocess.run(
				["pkill", signalOption, "-f", pattern],
				stdout=subprocess.DEVNULL,
				stderr=subprocess.DEVNULL,
				check=False,
			)
		except Exception as e:
			print(f"Error running pkill for {pattern}: {e}", flush=True)


def readersRunning():
	return any(
		akiraCore.isRunning("reader " + reader["name"])
		for reader in akiraCore.readers
	)


#############################
def main():
	dryRun = "--dry-run" in sys.argv

	# Try graceful shutdown first (SIGINT so mass can do gpio notify off)
	runPkill("-INT", dryRun=dryRun)

	# Give them a moment to handle signals and close sockets
	if not dryRun:
		time.sleep(SLEEP_SECONDS)

	# Anything still alive gets a TERM
	runPkill("-TERM", dryRun=dryRun)

	# Reader catches TERM for graceful cleanup. If it is stuck before its main
	# loop, do not let its process lock prevent the replacement from starting.
	if dryRun:
		print(f"DRY RUN: pkill -KILL -f {BASE_DIR}/reader  (only if still running)")
		return

	deadline = time.monotonic() + 1.0
	while readersRunning() and time.monotonic() < deadline:
		time.sleep(0.1)
	if readersRunning():
		print("Reader ignored TERM; sending KILL", flush=True)
		subprocess.run(
			["pkill", "-KILL", "-f", f"{BASE_DIR}/reader "],
			stdout=subprocess.DEVNULL,
			stderr=subprocess.DEVNULL,
			check=False,
		)


#############################
if __name__ == "__main__":
	main()
